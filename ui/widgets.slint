// VoxelMotion Studio v2 - Unified Lucide (1.5px) & Material-Aware Studio Widgets
// Adapts geometry, borders, switch hardware shape, and typography polarity directly from Theme/DesignSpec.

import { Theme } from "theme.slint";

export component Hairline inherits Rectangle {
    height: 1px;
    background: Theme.divider;
}

export component VerticalHairline inherits Rectangle {
    width: 1px;
    background: Theme.divider;
}

// Custom Geometric Isometric Cube + Motion Isotype (DEC-10)
export component AppLogoMark inherits Rectangle {
    in property <color> mark-color: Theme.text-primary;
    width: 16px;
    height: 16px;
    background: transparent;

    Path {
        width: 16px;
        height: 16px;
        viewbox-width: 24;
        viewbox-height: 24;
        fill: transparent;
        stroke: root.mark-color;
        stroke-width: 1.6px;
        stroke-line-cap: round;
        stroke-line-join: round;
        commands: "M12 2.5 L20 7.1 V16.9 L12 21.5 L4 16.9 V7.1 L12 2.5 Z M4.2 7.2 L12 11.7 L19.8 7.2 M12 11.7 V21.3";
    }
}

// Unified Lucide 24x24 (1.5px stroke) Vector Icon Primitive
export component VectorIcon inherits Path {
    in property <color> icon-color: Theme.text-secondary;
    in property <length> size: 15px;
    width: root.size;
    height: root.size;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: transparent;
    stroke: root.icon-color;
    stroke-width: 1.65px;
    stroke-line-cap: round;
    stroke-line-join: round;
    animate stroke { duration: Theme.dur-effects; easing: cubic-bezier(0, 0, 0, 1); }
}

// Material-aware Switch: Organic Pill in Pro/Daylight/Clay vs Sharp Mechanical Lever in Hardware/CAD
export component StudioSwitch inherits TouchArea {
    in property <bool> checked: false;
    callback toggled(bool);
    width: 34px;
    height: Theme.switch-pill ? 20px : 18px;
    mouse-cursor: pointer;

    Rectangle {
        width: parent.width;
        height: parent.height;
        border-radius: Theme.switch-pill ? 10px : Theme.radius-control;
        background: root.checked ? (Theme.wireframe-controls ? Theme.accent-soft : Theme.accent)
                                 : (Theme.wireframe-controls ? transparent : Theme.bg-toggle-off);
        border-width: 1px;
        border-color: root.checked ? Theme.accent : Theme.border-control;
        animate background { duration: Theme.dur-effects; easing: cubic-bezier(0, 0, 0, 1); }

        Rectangle {
            x: root.checked ? parent.width - self.width - 2px : 2px;
            y: 2px;
            width: Theme.switch-pill ? 16px : 12px;
            height: parent.height - 4px;
            border-radius: Theme.switch-pill ? 8px : Theme.radius-control;
            background: root.checked && Theme.wireframe-controls ? Theme.accent : #ffffff;
            animate x { duration: Theme.dur-spatial; easing: spring(0.18); }
        }
    }

    clicked => { root.toggled(!root.checked); }
}

// Clean Material-Aware Button (Ghost-Until-Hover or Surface/Wireframe/Primary)
export component StudioButton inherits TouchArea {
    in property <string> label;
    in property <bool> active: false;
    in property <bool> primary: false;
    in property <bool> compact: false;
    in property <bool> ghost: false;
    in property <bool> mono: false;
    in property <length> font-size: root.compact ? Theme.fs-meta : Theme.fs-body;
    mouse-cursor: pointer;
    height: root.compact ? 24px : 28px;

    Rectangle {
        border-radius: Theme.radius-control;
        background: root.primary
            ? (root.pressed ? Theme.accent-press : (root.has-hover ? Theme.accent-hover : Theme.accent))
            : (root.pressed ? Theme.bg-active
                : (root.active ? (Theme.wireframe-controls ? Theme.accent-soft : Theme.bg-active)
                    : (root.has-hover ? Theme.bg-hover
                        : (root.ghost || Theme.wireframe-controls ? transparent : Theme.bg-elevated))));
        border-width: (root.ghost && !root.active && !root.has-hover && !root.primary) ? 0px : Theme.border-control-w;
        border-color: root.primary ? Theme.accent
                    : (root.active ? (Theme.wireframe-controls ? Theme.accent : Theme.border-specular) : Theme.border-control);
        animate background { duration: Theme.dur-effects; easing: cubic-bezier(0, 0, 0, 1); }
        animate border-color { duration: Theme.dur-effects; easing: cubic-bezier(0, 0, 0, 1); }

        Text {
            text: root.label;
            color: root.primary ? #ffffff : (root.active || root.has-hover ? Theme.text-primary : Theme.text-secondary);
            font-family: (root.mono || Theme.mono-headers) ? Theme.font-mono : Theme.font-ui;
            font-size: root.font-size;
            font-weight: (root.primary || root.active) ? 600 : 500;
            horizontal-alignment: center;
            vertical-alignment: center;
            animate color { duration: Theme.dur-effects; easing: cubic-bezier(0, 0, 0, 1); }
        }
    }
}

// Compact Vector Icon Action Button (unified 24x24 Lucide grid, zero text clutter)
export component IconActionBtn inherits TouchArea {
    in property <string> path-cmd;
    in property <bool> active: false;
    in property <bool> primary: false;
    in property <bool> filled: false;
    in property <bool> disabled: false;
    in property <length> icon-size: 14px;
    in property <length> optical-x: 0px;
    width: 26px;
    height: 26px;
    mouse-cursor: root.disabled ? default : pointer;

    Rectangle {
        border-radius: Theme.radius-control;
        background: root.disabled ? transparent
                  : (root.primary ? (root.pressed ? Theme.accent-press : (root.has-hover ? Theme.accent-hover : Theme.accent))
                  : (root.pressed ? Theme.bg-active
                  : (root.active ? (Theme.wireframe-controls ? Theme.accent-soft : Theme.bg-active)
                  : (root.has-hover ? Theme.bg-hover : transparent))));
        border-width: (root.active || root.primary) ? 1px : 0px;
        border-color: root.primary ? Theme.accent : (Theme.wireframe-controls ? Theme.accent : Theme.border-control);
        animate background { duration: Theme.dur-effects; easing: cubic-bezier(0, 0, 0, 1); }

        Path {
            width: root.icon-size;
            height: root.icon-size;
            x: (parent.width - self.width) / 2 + root.optical-x;
            y: (parent.height - self.height) / 2;
            viewbox-width: 24;
            viewbox-height: 24;
            fill: root.filled ? (root.primary ? #ffffff : (root.active ? Theme.text-primary : Theme.text-secondary)) : transparent;
            stroke: root.filled ? transparent
                  : (root.disabled ? Theme.text-dim
                  : (root.primary ? #ffffff
                  : (root.active || root.has-hover ? Theme.text-primary : Theme.text-secondary)));
            stroke-width: 1.65px;
            stroke-line-cap: round;
            stroke-line-join: round;
            commands: root.path-cmd;
        }
    }
}

export component ToolRailBtn inherits TouchArea {
    in property <string> path-cmd;
    in property <bool> active: false;
    width: 28px;
    height: 28px;
    mouse-cursor: pointer;

    Rectangle {
        border-radius: Theme.radius-control;
        background: root.pressed ? Theme.bg-active
                  : (root.active ? (Theme.wireframe-controls ? Theme.accent-soft : Theme.bg-active)
                  : (root.has-hover ? Theme.bg-hover : transparent));
        border-width: root.active ? 1px : 0px;
        border-color: Theme.wireframe-controls ? Theme.accent : Theme.border-specular;
        animate background { duration: Theme.dur-effects; easing: cubic-bezier(0, 0, 0, 1); }

        Path {
            width: 15px;
            height: 15px;
            x: 6.5px;
            y: 6.5px;
            viewbox-width: 24;
            viewbox-height: 24;
            fill: transparent;
            stroke: root.active || root.has-hover ? Theme.text-primary : Theme.text-secondary;
            stroke-width: 1.65px;
            stroke-line-cap: round;
            stroke-line-join: round;
            commands: root.path-cmd;
        }
    }
}

// Native Windows 11 44x36px Geometric OS Caption Control (zero Unicode glyphs)
export component WinChromeBtn inherits TouchArea {
    in property <string> kind: "min"; // "min", "max", "restore", "close"
    width: 44px;
    height: 36px;
    mouse-cursor: pointer;

    Rectangle {
        background: root.kind == "close"
            ? (root.pressed ? #c42b1c : (root.has-hover ? #e81123 : transparent))
            : (root.pressed ? Theme.bg-active : (root.has-hover ? Theme.bg-hover : transparent));
        animate background { duration: Theme.dur-effects; easing: cubic-bezier(0, 0, 0, 1); }

        if root.kind == "min" : Path {
            width: 10px; height: 10px; x: 17px; y: 13px;
            viewbox-width: 10; viewbox-height: 10;
            stroke: root.has-hover ? Theme.text-primary : Theme.text-secondary;
            stroke-width: 1.15px;
            commands: "M1 5 H9";
        }
        if root.kind == "max" : Path {
            width: 10px; height: 10px; x: 17px; y: 13px;
            viewbox-width: 10; viewbox-height: 10;
            fill: transparent;
            stroke: root.has-hover ? Theme.text-primary : Theme.text-secondary;
            stroke-width: 1.15px;
            commands: "M1.5 1.5 H8.5 V8.5 H1.5 Z";
        }
        if root.kind == "restore" : Path {
            width: 10px; height: 10px; x: 17px; y: 13px;
            viewbox-width: 10; viewbox-height: 10;
            fill: transparent;
            stroke: root.has-hover ? Theme.text-primary : Theme.text-secondary;
            stroke-width: 1.15px;
            commands: "M1.5 3.2 H6.8 V8.5 H1.5 Z M3.2 3.2 V1.5 H8.5 V6.8 H6.8";
        }
        if root.kind == "close" : Path {
            width: 10px; height: 10px; x: 17px; y: 13px;
            viewbox-width: 10; viewbox-height: 10;
            stroke: root.has-hover ? #ffffff : Theme.text-secondary;
            stroke-width: 1.2px;
            stroke-line-cap: round;
            commands: "M1.5 1.5 L8.5 8.5 M8.5 1.5 L1.5 8.5";
        }
    }
}

// Flat Scrubbable Transform Cell (clean resting state, hover steppers)
export component AxisCell inherits Rectangle {
    in property <string> axis: "X";
    in property <color> axis-color: Theme.axis-x;
    in property <string> value-text: "0.00";
    callback step(float);
    callback scrub-start();
    callback scrub(float);
    callback reset-axis();

    height: 24px;
    border-radius: Theme.radius-control;
    background: (drag-ta.has-hover || up-ta.has-hover || dn-ta.has-hover) ? Theme.bg-hover
              : (Theme.wireframe-controls ? transparent : Theme.bg-input);
    border-width: 1px;
    border-color: (drag-ta.has-hover || up-ta.has-hover || dn-ta.has-hover) ? Theme.border-specular : Theme.border-control;
    animate background { duration: Theme.dur-effects; easing: cubic-bezier(0, 0, 0, 1); }

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 3px;
        spacing: 3px;
        alignment: space-between;

        drag-ta := TouchArea {
            horizontal-stretch: 1;
            mouse-cursor: ew-resize;
            property <bool> dragging: false;
            property <float> last-x: 0;
            double-clicked => { root.reset-axis(); }
            pointer-event(ev) => {
                let mx = self.mouse-x / 1px;
                if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                    self.dragging = true;
                    self.last-x = mx;
                    root.scrub-start();
                } else if (ev.kind == PointerEventKind.move && self.dragging) {
                    let dx = mx - self.last-x;
                    self.last-x = mx;
                    if (abs(dx) > 0.01) {
                        root.scrub(dx);
                    }
                } else if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) {
                    self.dragging = false;
                }
            }

            HorizontalLayout {
                spacing: 4px;
                Rectangle {
                    width: 2.5px;
                    height: 10px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 1px;
                    background: root.axis-color;
                }
                Text {
                    text: root.axis;
                    color: Theme.text-secondary;
                    font-family: Theme.mono-headers ? Theme.font-mono : Theme.font-ui;
                    font-size: Theme.fs-meta;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Text {
                    text: root.value-text;
                    color: Theme.text-primary;
                    font-family: Theme.font-mono;
                    font-size: Theme.fs-mono;
                    font-weight: 500;
                    vertical-alignment: center;
                    horizontal-alignment: right;
                    horizontal-stretch: 1;
                }
            }
        }

        VerticalLayout {
            width: 10px;
            alignment: center;
            spacing: 2px;
            up-ta := TouchArea {
                height: 8px;
                mouse-cursor: pointer;
                clicked => { root.step(1.0); }
                Path {
                    width: 6px; height: 4px; x: 2px; y: 2px;
                    viewbox-width: 10; viewbox-height: 6;
                    fill: up-ta.has-hover ? Theme.text-primary : Theme.text-dim;
                    commands: "M5 0 L10 6 L0 6 Z";
                }
            }
            dn-ta := TouchArea {
                height: 8px;
                mouse-cursor: pointer;
                clicked => { root.step(-1.0); }
                Path {
                    width: 6px; height: 4px; x: 2px; y: 2px;
                    viewbox-width: 10; viewbox-height: 6;
                    fill: dn-ta.has-hover ? Theme.text-primary : Theme.text-dim;
                    commands: "M0 0 L10 0 L5 6 Z";
                }
            }
        }
    }
}

export component SectionLabel inherits Text {
    color: Theme.text-dim;
    font-family: Theme.mono-headers ? Theme.font-mono : Theme.font-ui;
    font-size: Theme.fs-meta;
    font-weight: 700;
}
