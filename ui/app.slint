// VoxelMotion Studio v2 - Continuous Surface Canvas-First Studio (DEC-01..DEC-17)

import "./fonts/PlusJakartaSans-Regular.ttf";
import "./fonts/PlusJakartaSans-Medium.ttf";
import "./fonts/PlusJakartaSans-SemiBold.ttf";
import "./fonts/PlusJakartaSans-Bold.ttf";
import "./fonts/JetBrainsMono-Medium.ttf";
import "./fonts/JetBrainsMono-Bold.ttf";

import { Theme } from "theme.slint";
export { Theme }
import {
    Hairline,
    VerticalHairline,
    AppLogoMark,
    VectorIcon,
    StudioSwitch,
    StudioButton,
    IconActionBtn,
    ToolRailBtn,
    WinChromeBtn,
    AxisCell,
    SectionLabel
} from "widgets.slint";
import { ListView } from "std-widgets.slint";

export struct PaletteEntry {
    kind: string,
    id: string,
    title: string,
    subtitle: string,
}

export struct CategoryEntry {
    name: string,
    count: int,
}

export struct CategoryRow {
    left_idx: int,
    left_name: string,
    left_count: int,
    right_idx: int,
    right_name: string,
    right_count: int,
}

export struct FamilyChipRow {
    left_idx: int,
    left_label: string,
    left_on: bool,
    right_idx: int,
    right_label: string,
    right_on: bool,
}

export struct WeaponListItem {
    index: int,
    id: string,
    name: string,
    mod_name: string,
    category: string,
    status_tag: string,
    status_idx: int,
    icon: image,
}

export struct GalleryItem {
    id: string,
    name: string,
    group: string,
    source_label: string,
    target_label: string,
    compatible: bool,
    status_tag: string,
    status_idx: int,
    thumb: image,
    active: bool,
}

export struct VfxEventItem {
    index: int,
    time_text: string,
    kind_label: string,
    color_hex: string,
    scale_text: string,
}

export struct TimelineTrack {
    bone_idx: int,
    name: string,
    dot_color: color,
    active: bool,
    visible: bool,
}

export struct RulerTick {
    frac: float,
    label: string,
    major: bool,
    mid: bool,
}

export struct TimelineDiamond {
    kf_idx: int,
    track_idx: int,
    frac: float,
    is_impact: bool,
    is_selected: bool,
    dot_color: color,
}

export component MainWindow inherits Window {
    title: "VoxelMotion Studio";
    no-frame: true;
    preferred-width: 1440px;
    preferred-height: 890px;
    min-width: 1180px;
    min-height: 760px;
    background: Theme.bg-shell;
    default-font-family: Theme.font-ui;
    default-font-size: Theme.fs-body;

    // Chrome & Popovers / Modals (Single Unified Workspace: DEC-01)
    in-out property <bool> is-maximized: false;
    in-out property <bool> has-unsaved: false;
    in-out property <bool> can-undo: false;
    in-out property <bool> can-redo: false;
    in-out property <bool> weapons-pinned: false;
    in-out property <bool> file-menu-open: false;
    in-out property <bool> clip-switcher-open: false;
    in-out property <bool> clip-renaming: false;
    in-out property <string> clip-rename-draft: "";
    in-out property <bool> weapon-picker-open: false;
    in-out property <bool> camera-menu-open: false;
    in-out property <bool> view-menu-open: false;
    in-out property <bool> export-modal-open: false;
    in-out property <bool> settings-modal-open: false;
    callback start-drag();
    callback win-minimize();
    callback win-maximize();
    callback win-close();

    // Weapon Library State
    in-out property <string> weapon-search: "";
    in-out property <int> selected-category: 0;
    in-out property <[CategoryEntry]> categories: [];
    in-out property <[CategoryRow]> category-rows: [];
    in-out property <[WeaponListItem]> filtered-weapons: [];
    in-out property <int> active-weapon-index: 0;
    in-out property <string> active-weapon-name: "Espada de Acero";
    in-out property <string> active-weapon-mod: "VoxelMotion";
    in-out property <string> active-weapon-family: "Espadas";
    in-out property <string> active-weapon-class: "MEDIUM";
    in-out property <image> weapon-card-img;
    in-out property <int> total-weapon-count: 8;
    callback select-category(int);
    callback search-weapons(string);
    callback select-weapon(int);
    callback cycle-weapon(int);
    callback import-custom-weapons();

    // Main 3D Viewport State & Interactions
    in-out property <image> main-viewport;
    in-out property <string> active-clip-name: "Nueva Acción";
    in-out property <int> active-tool: 1; // 1 Rotate, 2 Scale, 4 Move
    in-out property <bool> show-gizmo: true;
    callback select-tool(int);
    callback toggle-gizmo();
    callback toggle-solo-weapon();
    callback rename-clip(string);
    in-out property <bool> solo-weapon: false;
    in-out property <string> status-pill: "BrazoDerecho · Rotar";
    in-out property <string> kf-badge: "KF 1/4";
    in-out property <bool> auto-keyframe: true;
    in-out property <bool> text-input-active: false;

    callback viewport-resized(float, float);
    callback vp-pointer-down(float, float, int, bool, bool, float, float);
    callback vp-pointer-hover(float, float, float, float);
    callback vp-pointer-move(float, float, bool, bool, float, float);
    callback vp-pointer-up(float, float, bool, float, float);
    callback vp-wheel(float, float, float, float, float);
    callback focus-bone();
    callback reset-camera();
    callback set-camera-preset(int);

    // Playback State
    in-out property <bool> playing: false;
    in-out property <int> current-frame: 0;
    in-out property <int> total-frames: 60;
    in-out property <string> speed-label: "1.0x";
    in-out property <float> playhead-frac: 0.0;
    in-out property <float> impact-frac: 0.35;
    in-out property <bool> has-impact: false;
    in-out property <string> impact-time-text: "Sin marca";
    callback toggle-play();
    callback step-frame(int);
    callback jump-kf(int);
    callback jump-edge(int);
    callback cycle-speed();
    callback studio-key(string, bool, bool, bool);
    callback studio-key-up(string);

    // Inspector State (DEC-16: 0 Pose, 1 Reglas y VFX)
    in-out property <int> inspector-tab: 0;
    in-out property <string> active-bone-name: "BrazoDerecho";
    in-out property <int> active-bone-idx: 3;
    in-out property <string> pos-x: "0.00";
    in-out property <string> pos-y: "0.00";
    in-out property <string> pos-z: "0.00";
    in-out property <string> rot-x: "-48.0°";
    in-out property <string> rot-y: "-42.0°";
    in-out property <string> rot-z: "34.0°";
    in-out property <string> scl-x: "1.00";
    in-out property <string> scl-y: "1.00";
    in-out property <string> scl-z: "1.00";
    in-out property <bool> anim-loop: false;
    in-out property <string> duration-text: "0.48";
    in-out property <float> duration-val: 0.48;
    in-out property <int> easing-idx: 0;
    in-out property <bool> shadows-enabled: true;
    in-out property <bool> onion-enabled: true;
    in-out property <bool> trail-enabled: true;
    in-out property <int> bg-idx: 0;

    callback step-bone-axis(int, int, float);
    callback scrub-axis-start();
    callback scrub-bone-axis(int, int, float);
    callback reset-bone-axis(int, int);
    callback toggle-loop(bool);
    callback change-duration(float);
    callback set-clip-frames(int);
    callback set-easing(int);
    callback toggle-shadows(bool);
    callback toggle-onion(bool);
    callback toggle-trail(bool);
    callback set-bg-mode(int);
    callback undo-action();
    callback redo-action();
    callback reset-pose-action();
    callback copy-pose-action();
    callback paste-pose-action();
    callback mirror-pose-action();

    // Timeline Tracks & Diamonds
    in-out property <[TimelineTrack]> timeline-tracks: [];
    in-out property <[TimelineTrack]> all-bones-tracks: [];
    in-out property <[TimelineDiamond]> timeline-diamonds: [];
    in-out property <image> ruler-notches-img;
    in-out property <image> lanes-grid-img;
    in-out property <bool> show-all-bones: false;
    in-out property <bool> timeline-bone-scope: true;
    in-out property <string> timeline-zoom-label: "1.0x";
    in-out property <bool> timeline-zoomed: false;
    in-out property <float> timeline-view-start: 0.0;
    in-out property <float> timeline-view-span: 1.0;
    in-out property <bool> playhead-visible: true;
    in-out property <bool> impact-visible: true;
    in-out property <int> bone-clipboard-count: 0;
    in-out property <string> bone-clipboard-label: "";
    in-out property <int> selected-range-count: 0;
    in-out property <int> selected-range-track-idx: -1;
    in-out property <float> selected-range-start-frac: 0.0;
    in-out property <float> selected-range-end-frac: 0.0;
    in-out property <int> selected-kf-idx: 0;
    in-out property <bool> shift-held: false;
    in-out property <bool> ctrl-held: false;
    in-out property <bool> timeline-ctx-open: false;
    in-out property <length> timeline-ctx-x: 40px;
    in-out property <int> timeline-ctx-bone-idx: 3;
    in-out property <string> timeline-ctx-bone-name: "BrazoDerecho";
    callback scrub-timeline(float);
    callback click-diamond(int, int, bool);
    callback drag-diamond(int, float);
    callback zoom-timeline(float, float);
    callback reset-timeline-zoom();
    callback pan-timeline(float);
    callback set-timeline-view-start(float);
    callback set-timeline-bone-scope(bool);
    callback copy-timeline-action();
    callback paste-timeline-action();
    callback copy-bone-action(bool);
    callback paste-bone-action(bool);
    callback delete-bone-action(bool);
    callback delete-full-keyframe-action();
    callback add-keyframe-action();
    callback dup-kf-next();
    callback delete-keyframe-action();
    callback mark-impact-action();
    callback toggle-auto-kf(bool);
    callback toggle-all-bones();
    callback select-bone-idx(int);
    callback toggle-bone-visible(int);
    callback show-all-bones-reset();

    // Animation Gallery State
    in-out property <string> gallery-search: "";
    in-out property <int> gallery-filter: 0;
    in-out property <[GalleryItem]> gallery-items: [];
    in-out property <string> featured-gallery-id: "action_1";
    in-out property <string> featured-gallery-name: "Nueva Acción";
    in-out property <image> featured-gallery-thumb;
    callback filter-gallery(int);
    callback search-gallery(string);
    callback select-gallery-item(string);
    callback add-gallery-clip(string);
    callback create-blank-clip();
    callback reset-blank-scene();
    callback load-demo-presets();

    // Export & Preferences State
    in-out property <int> export-format-idx: 0;
    in-out property <string> export-dest: "./exports/";
    in-out property <bool> include-events: true;
    in-out property <bool> optimize-keyframes: true;
    in-out property <string> gpu-adapter-name: "DirectX 12";
    in-out property <int> clips-count: 1;
    in-out property <string> toast-message: "";
    in-out property <bool> toast-visible: false;
    in-out property <int> theme-idx: 0;
    in-out property <bool> ui-motion-enabled: true;
    in-out property <bool> gpu-low-power: false;
    in-out property <bool> focus-mode: false;
    in-out property <bool> palette-open: false;
    in-out property <string> palette-query: "";
    in-out property <[PaletteEntry]> palette-items: [];
    callback browse-export-dest();
    callback export-project-action();
    callback export-strip-png-action();
    callback select-theme(int);
    callback toggle-ui-motion(bool);
    callback set-gpu-power-mode(bool);
    callback toggle-focus-mode();
    callback open-palette();
    callback close-palette();
    callback search-palette(string);
    callback exec-palette-item(string);
    callback exec-first-palette-item();

    // Curation & VFX
    in-out property <bool> has-rell-profile: false;
    in-out property <string> rell-profile-label: "Modo Público (sin modpack)";
    in-out property <int> weapon-status-filter: 0;
    in-out property <int> active-weapon-status: 0;
    in-out property <string> active-weapon-bc-arch: "";
    in-out property <int> gallery-source-filter: 0;
    in-out property <int> gallery-status-filter: 0;
    in-out property <bool> gallery-compat-only: false;
    in-out property <int> active-clip-status: 0;
    in-out property <string> active-clip-source: "Custom";
    in-out property <bool> active-clip-compatible: true;
    in-out property <string> active-clip-targets: "Universal (todos)";
    in-out property <bool> active-clip-universal: true;
    in-out property <bool> active-clip-only-current: false;
    in-out property <[FamilyChipRow]> clip-family-rows: [];
    in-out property <[VfxEventItem]> clip-vfx-events: [];
    in-out property <int> new-vfx-kind: 0;
    in-out property <int> new-vfx-color-idx: 0;
    callback filter-weapon-status(int);
    callback set-weapon-status(int, int);
    callback export-curated-weapons-action();
    callback filter-gallery-source(int);
    callback filter-gallery-status(int);
    callback toggle-gallery-compat-only();
    callback equip-compatible-weapon();
    callback allow-active-weapon-family();
    callback toggle-clip-family(int);
    callback set-clip-universal();
    callback toggle-clip-only-current-weapon();
    callback set-clip-status(string, int);
    callback add-vfx-event(int, int);
    callback remove-vfx-event(int);
    callback jump-to-vfx-event(int);
    callback export-rell-seas-action();

    function close-popovers() {
        root.file-menu-open = false;
        root.clip-switcher-open = false;
        root.weapon-picker-open = false;
        root.camera-menu-open = false;
        root.view-menu-open = false;
        root.timeline-ctx-open = false;
    }

    root-focus := FocusScope {
        width: 100%;
        height: 100%;
        init => { self.focus(); }
        key-pressed(ev) => {
            root.shift-held = ev.modifiers.shift || ev.text == Key.Shift;
            root.ctrl-held = ev.modifiers.control || ev.text == Key.Control;
            if (ev.modifiers.control && (ev.text == "k" || ev.text == "K")) {
                root.close-popovers();
                if (root.palette-open) {
                    root.text-input-active = false;
                    self.focus();
                    root.close-palette();
                } else {
                    root.open-palette();
                }
                return accept;
            }
            if (ev.modifiers.control && (ev.text == "e" || ev.text == "E")) {
                root.close-popovers();
                if (root.has-rell-profile) {
                    root.export-rell-seas-action();
                } else {
                    root.export-project-action();
                }
                return accept;
            }
            if (ev.modifiers.control && ev.text == ",") {
                root.close-popovers();
                root.settings-modal-open = !root.settings-modal-open;
                return accept;
            }
            if (ev.text == Key.Escape) {
                if (root.clip-renaming) {
                    root.clip-renaming = false;
                    root.text-input-active = false;
                    self.focus();
                    return accept;
                }
                if (root.palette-open) {
                    root.text-input-active = false;
                    self.focus();
                    root.close-palette();
                    return accept;
                }
                if (root.export-modal-open || root.settings-modal-open || root.file-menu-open
                    || root.clip-switcher-open || root.weapon-picker-open || root.camera-menu-open || root.view-menu-open || root.timeline-ctx-open) {
                    root.close-popovers();
                    root.export-modal-open = false;
                    root.settings-modal-open = false;
                    self.focus();
                    return accept;
                }
            }
            if (!root.text-input-active) {
                if (ev.text == Key.Tab) {
                    root.close-popovers();
                    root.toggle-focus-mode();
                    return accept;
                }
                if (ev.text == Key.Space) {
                    root.studio-key("space", ev.modifiers.control, ev.modifiers.shift, ev.modifiers.alt);
                    return accept;
                }
                if (ev.text == Key.LeftArrow) {
                    root.studio-key("left", ev.modifiers.control, ev.modifiers.shift, ev.modifiers.alt);
                    return accept;
                }
                if (ev.text == Key.RightArrow) {
                    root.studio-key("right", ev.modifiers.control, ev.modifiers.shift, ev.modifiers.alt);
                    return accept;
                }
                if (ev.text == Key.Delete || ev.text == Key.Backspace) {
                    root.studio-key("del", ev.modifiers.control, ev.modifiers.shift, ev.modifiers.alt);
                    return accept;
                }
                root.studio-key(ev.text, ev.modifiers.control, ev.modifiers.shift, ev.modifiers.alt);
                return accept;
            }
            if (ev.text == Key.Escape) {
                self.focus();
                return accept;
            }
            reject
        }
        key-released(ev) => {
            if (ev.text == Key.Shift) {
                root.shift-held = false;
            } else {
                root.shift-held = ev.modifiers.shift;
            }
            if (ev.text == Key.Control) {
                root.ctrl-held = false;
            } else {
                root.ctrl-held = ev.modifiers.control;
            }
            root.studio-key-up(ev.text);
            accept
        }
        changed has-focus => {
            if (!self.has-focus) {
                root.shift-held = false;
                root.ctrl-held = false;
                root.studio-key-up("*");
            }
        }

        // Outer Continuous Shell (1px border only when windowed)
        Rectangle {
            width: 100%;
            height: 100%;
            background: Theme.bg-shell;
            border-width: root.is-maximized ? 0px : 1px;
            border-color: Theme.divider;

            VerticalLayout {
                spacing: 0px;
                padding: 0px;

                // ==================== PIEZA #1: 36PX SILENT CHROME TOP BAR (DEC-01..DEC-09) ====================
                Rectangle {
                    height: 36px;
                    background: Theme.bg-shell;

                    if Theme.topbar-divider : Hairline {
                        y: parent.height - 1px;
                        width: parent.width;
                    }

                    // Full-width drag surface behind controls
                    TouchArea {
                        width: parent.width;
                        height: parent.height;
                        pointer-event(ev) => {
                            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                                root.close-popovers();
                                root.start-drag();
                            }
                        }
                        double-clicked => { root.win-maximize(); }
                    }

                    // Left: Archivo menu trigger with clean geometric AppLogoMark
                    HorizontalLayout {
                        x: 8px;
                        y: 0px;
                        height: 36px;
                        alignment: start;

                        file-ta := TouchArea {
                            height: 28px;
                            y: 4px;
                            width: 100px;
                            mouse-cursor: pointer;
                            clicked => {
                                let next = !root.file-menu-open;
                                root.close-popovers();
                                root.file-menu-open = next;
                            }
                            Rectangle {
                                border-radius: Theme.radius-control;
                                background: root.file-menu-open ? Theme.bg-active : (file-ta.has-hover ? Theme.bg-hover : transparent);
                                border-width: (Theme.wireframe-controls && (file-ta.has-hover || root.file-menu-open)) ? 1px : 0px;
                                border-color: Theme.border-control;
                                animate background { duration: Theme.dur-effects; easing: cubic-bezier(0, 0, 0, 1); }

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 7px;
                                    alignment: center;
                                    AppLogoMark {
                                        y: (parent.height - self.height) / 2;
                                        mark-color: Theme.text-secondary;
                                    }
                                    Text {
                                        text: Theme.mono-headers ? "ARCHIVO" : "Archivo";
                                        color: (file-ta.has-hover || root.file-menu-open) ? Theme.text-primary : Theme.text-secondary;
                                        font-family: Theme.mono-headers ? Theme.font-mono : Theme.font-ui;
                                        font-size: Theme.fs-body;
                                        font-weight: 500;
                                        vertical-alignment: center;
                                    }
                                    VectorIcon {
                                        y: (parent.height - self.height) / 2 + 1px;
                                        size: 12px;
                                        icon-color: Theme.text-dim;
                                        commands: "M6 9 L12 15 L18 9";
                                    }
                                }
                            }
                        }
                    }

                    // Center: Active Clip Title + Unsaved Dot + Click Switcher + Double-Click Inline Rename (DEC-02)
                    Rectangle {
                        x: (parent.width - self.width) / 2;
                        y: 4px;
                        width: 240px;
                        height: 28px;
                        border-radius: Theme.radius-control;
                        background: root.clip-renaming ? Theme.bg-input
                                  : (root.clip-switcher-open ? Theme.bg-active : transparent);
                        border-width: root.clip-renaming ? 1px : 0px;
                        border-color: Theme.accent;
                        animate background { duration: Theme.dur-effects; easing: cubic-bezier(0, 0, 0, 1); }

                        if !root.clip-renaming : clip-title-ta := TouchArea {
                            width: parent.width;
                            height: parent.height;
                            mouse-cursor: pointer;
                            Rectangle {
                                width: parent.width;
                                height: parent.height;
                                border-radius: Theme.radius-control;
                                background: (!root.clip-switcher-open && clip-title-ta.has-hover) ? Theme.bg-hover : transparent;
                                animate background { duration: Theme.dur-effects; easing: cubic-bezier(0, 0, 0, 1); }
                            }
                            clicked => {
                                let next = !root.clip-switcher-open;
                                root.close-popovers();
                                root.clip-switcher-open = next;
                            }
                            double-clicked => {
                                root.close-popovers();
                                root.clip-rename-draft = root.active-clip-name;
                                root.clip-renaming = true;
                            }
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 10px;
                                spacing: 6px;
                                alignment: center;
                                Text {
                                    text: root.active-clip-name;
                                    color: Theme.text-primary;
                                    font-family: Theme.mono-headers ? Theme.font-mono : Theme.font-ui;
                                    font-size: Theme.fs-title;
                                    font-weight: 600;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }
                                if root.has-unsaved : Rectangle {
                                    width: 6px;
                                    height: 6px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 3px;
                                    background: Theme.accent;
                                }
                                VectorIcon {
                                    y: (parent.height - self.height) / 2 + 1px;
                                    size: 12px;
                                    icon-color: clip-title-ta.has-hover ? Theme.text-primary : Theme.text-dim;
                                    commands: "M6 9 L12 15 L18 9";
                                }
                            }
                        }

                        if root.clip-renaming : TextInput {
                            x: 10px;
                            width: parent.width - 20px;
                            height: parent.height;
                            text <=> root.clip-rename-draft;
                            color: Theme.text-primary;
                            font-size: Theme.fs-title;
                            font-weight: 600;
                            single-line: true;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            init => { self.focus(); }
                            changed has-focus => { root.text-input-active = self.has-focus; }
                            accepted => {
                                root.rename-clip(self.text);
                                root.clip-renaming = false;
                                root.text-input-active = false;
                                root-focus.focus();
                            }
                        }
                    }

                    // Right: Monochrome Settings Cog + 14px Micro-Divider + Native 44x36px OS Chrome (DEC-08, DEC-09)
                    HorizontalLayout {
                        x: parent.width - 172px;
                        y: 0px;
                        width: 172px;
                        height: 36px;
                        spacing: 0px;
                        alignment: end;

                        Rectangle {
                            width: 34px;
                            height: 36px;
                            settings-ta := TouchArea {
                                width: 28px;
                                height: 28px;
                                x: 3px;
                                y: 4px;
                                mouse-cursor: pointer;
                                clicked => {
                                    root.close-popovers();
                                    root.settings-modal-open = !root.settings-modal-open;
                                }
                                Rectangle {
                                    border-radius: Theme.radius-control;
                                    background: root.settings-modal-open ? Theme.bg-active : (settings-ta.has-hover ? Theme.bg-hover : transparent);
                                    VectorIcon {
                                        x: 6.5px;
                                        y: 6.5px;
                                        size: 15px;
                                        icon-color: (settings-ta.has-hover || root.settings-modal-open) ? Theme.text-primary : Theme.text-secondary;
                                        commands: "M12 9 A3 3 0 1 0 12 15 A3 3 0 1 0 12 9 Z M12 5 A7 7 0 1 0 12 19 A7 7 0 1 0 12 5 Z M12 2 V4 M12 20 V22 M4.9 4.9 L6.3 6.3 M17.7 17.7 L19.1 19.1 M2 12 H4 M20 12 H22 M4.9 19.1 L6.3 17.7 M17.7 6.3 L19.1 4.9";
                                    }
                                }
                            }
                        }

                        Rectangle {
                            width: 6px;
                            height: 36px;
                            Rectangle {
                                x: 2px;
                                y: 11px;
                                width: 1px;
                                height: 14px;
                                background: Theme.divider;
                            }
                        }

                        WinChromeBtn { kind: "min"; clicked => { root.win-minimize(); } }
                        WinChromeBtn { kind: root.is-maximized ? "restore" : "max"; clicked => { root.win-maximize(); } }
                        WinChromeBtn { kind: "close"; clicked => { root.win-close(); } }
                    }
                }

                // ==================== CONTINUOUS 4-ZONE BODY (DEC-12) ====================
                VerticalLayout {
                    vertical-stretch: 1;
                    spacing: 0px;

                    // TOP ROW: CLIP/WEAPON NAVIGATOR | 3D STAGE | INSPECTOR
                    HorizontalLayout {
                        vertical-stretch: 1;
                        spacing: 0px;

                        // LEFT COLUMN (244px): Monochrome Weapon Header + Clips Grid (or Pinned Weapons) (DEC-13)
                        Rectangle {
                            width: root.focus-mode ? 0px : 244px;
                            opacity: root.focus-mode ? 0.0 : 1.0;
                            visible: self.width > 4px;
                            clip: true;
                            background: Theme.bg-sidebar;
                            animate width { duration: Theme.dur-spatial; easing: spring(0.10); }
                            animate opacity { duration: Theme.dur-effects; easing: cubic-bezier(0, 0, 0, 1); }

                            VerticalLayout {
                                spacing: 0px;

                                // Top Monochrome Weapon Switcher Row (36px)
                                Rectangle {
                                    height: 36px;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 6px;
                                        spacing: 4px;
                                        alignment: space-between;

                                        wp-btn := TouchArea {
                                            horizontal-stretch: 1;
                                            height: 28px;
                                            y: 4px;
                                            mouse-cursor: pointer;
                                            clicked => {
                                                let next = !root.weapon-picker-open;
                                                root.close-popovers();
                                                root.weapon-picker-open = next;
                                            }
                                            Rectangle {
                                                border-radius: Theme.radius-control;
                                                background: root.weapon-picker-open ? Theme.bg-active : (wp-btn.has-hover ? Theme.bg-hover : transparent);
                                                HorizontalLayout {
                                                    padding-left: 6px;
                                                    padding-right: 6px;
                                                    spacing: 7px;
                                                    VectorIcon {
                                                        y: (parent.height - self.height) / 2;
                                                        size: 14px;
                                                        icon-color: Theme.text-secondary;
                                                        commands: "M14.5 17.5 L3 6 V3 H6 L17.5 14.5 M13 19 L19 13 M16 16 L20 20 M19 21 L21 19";
                                                    }
                                                    Text {
                                                        text: root.active-weapon-name;
                                                        color: Theme.text-primary;
                                                        font-size: Theme.fs-body;
                                                        font-weight: 600;
                                                        overflow: elide;
                                                        vertical-alignment: center;
                                                        horizontal-stretch: 1;
                                                    }
                                                    VectorIcon {
                                                        y: (parent.height - self.height) / 2 + 1px;
                                                        size: 12px;
                                                        icon-color: Theme.text-dim;
                                                        commands: "M6 9 L12 15 L18 9";
                                                    }
                                                }
                                            }
                                        }

                                        HorizontalLayout {
                                            spacing: 2px;
                                            y: 5px;
                                            height: 26px;
                                            IconActionBtn {
                                                path-cmd: "M15 18 L9 12 L15 6";
                                                icon-size: 13px;
                                                clicked => { root.cycle-weapon(-1); }
                                            }
                                            IconActionBtn {
                                                path-cmd: "M9 18 L15 12 L9 6";
                                                icon-size: 13px;
                                                clicked => { root.cycle-weapon(1); }
                                            }
                                        }
                                    }
                                }

                                Hairline { }

                                // VIEW A (Default 95%): Vertical Clips Browser (scroll natural)
                                if !root.weapons-pinned : VerticalLayout {
                                    vertical-stretch: 1;
                                    padding: 10px;
                                    spacing: 8px;

                                    HorizontalLayout {
                                        alignment: space-between;
                                        spacing: 4px;
                                        SectionLabel {
                                            text: Theme.mono-headers ? "CLIPS (" + root.gallery-items.length + ")" : "Clips (" + root.gallery-items.length + ")";
                                            vertical-alignment: center;
                                        }
                                        HorizontalLayout {
                                            spacing: 2px;
                                            IconActionBtn {
                                                path-cmd: "M12 5 V19 M5 12 H19";
                                                icon-size: 13px;
                                                clicked => { root.create-blank-clip(); }
                                            }
                                            IconActionBtn {
                                                path-cmd: "M9 9 H20 V20 H9 Z M5 15 H4 A2 2 0 0 1 2 13 V4 A2 2 0 0 1 4 2 H13 A2 2 0 0 1 15 4 V5";
                                                icon-size: 13px;
                                                clicked => { root.add-gallery-clip(root.featured-gallery-id); }
                                            }
                                        }
                                    }

                                    // Clean Search Field (zero nested LineEdit chrome)
                                    Rectangle {
                                        height: 28px;
                                        border-radius: Theme.radius-control;
                                        background: Theme.wireframe-controls ? transparent : Theme.bg-input;
                                        border-width: 1px;
                                        border-color: gallery-search-edit.has-focus ? Theme.accent : Theme.border-control;
                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            spacing: 6px;
                                            VectorIcon {
                                                y: 7px;
                                                size: 13px;
                                                icon-color: Theme.text-dim;
                                                commands: "M11 4 A7 7 0 1 0 11 18 A7 7 0 1 0 11 4 Z M20 20 L16 16";
                                            }
                                            Rectangle {
                                                horizontal-stretch: 1;
                                                height: 28px;
                                                clip: true;
                                                if root.gallery-search == "" : Text {
                                                    width: parent.width;
                                                    height: parent.height;
                                                    text: "Buscar animación...";
                                                    color: Theme.text-dim;
                                                    font-size: Theme.fs-body;
                                                    vertical-alignment: center;
                                                }
                                                gallery-search-edit := TextInput {
                                                    width: parent.width;
                                                    height: parent.height;
                                                    text <=> root.gallery-search;
                                                    color: Theme.text-primary;
                                                    font-size: Theme.fs-body;
                                                    single-line: true;
                                                    vertical-alignment: center;
                                                    changed has-focus => { root.text-input-active = self.has-focus; }
                                                    edited => { root.search-gallery(self.text); }
                                                }
                                            }
                                        }
                                    }

                                    // Readable Compact Filter Row (full words, zero abbreviations)
                                    HorizontalLayout {
                                        spacing: 4px;
                                        StudioButton {
                                            horizontal-stretch: 1;
                                            compact: true;
                                            label: root.gallery-filter == 0 ? "Todas"
                                                 : (root.gallery-filter == 1 ? "Combate"
                                                 : (root.gallery-filter == 2 ? "Mover"
                                                 : (root.gallery-filter == 3 ? "Defensa"
                                                 : (root.gallery-filter == 4 ? "Especial" : "Interac."))));
                                            clicked => { root.filter-gallery(root.gallery-filter >= 5 ? 0 : root.gallery-filter + 1); }
                                        }
                                        StudioButton {
                                            width: 86px;
                                            compact: true;
                                            active: root.gallery-compat-only;
                                            label: "Compatibles";
                                            clicked => { root.toggle-gallery-compat-only(); }
                                        }
                                    }

                                    // 2-Column Vertical Clip Thumbnail Grid
                                    Flickable {
                                        vertical-stretch: 1;
                                        interactive: true;
                                        content-height: max(self.height, ceil(root.gallery-items.length / 2) * 102px + 4px);

                                        for item[gi] in root.gallery-items : TouchArea {
                                            x: mod(gi, 2) * 112px;
                                            y: floor(gi / 2) * 102px;
                                            width: 108px;
                                            height: 96px;
                                            mouse-cursor: pointer;
                                            clicked => { root.select-gallery-item(item.id); }

                                            Rectangle {
                                                border-radius: Theme.radius-control;
                                                background: item.active
                                                    ? (Theme.wireframe-controls ? Theme.accent-soft : Theme.bg-active)
                                                    : (parent.has-hover ? Theme.bg-hover : (Theme.wireframe-controls ? transparent : Theme.bg-elevated));
                                                border-width: 1px;
                                                border-color: item.active
                                                    ? (item.compatible ? Theme.accent : Theme.gold)
                                                    : (parent.has-hover ? Theme.border-specular : Theme.border-control);
                                                animate background { duration: Theme.dur-effects; easing: cubic-bezier(0, 0, 0, 1); }

                                                VerticalLayout {
                                                    padding: 4px;
                                                    spacing: 3px;
                                                    HorizontalLayout {
                                                        alignment: space-between;
                                                        Text {
                                                            text: item.source_label;
                                                            color: Theme.text-dim;
                                                            font-family: Theme.font-mono;
                                                            font-size: Theme.fs-meta;
                                                        }
                                                        if item.status_tag != "" : Text {
                                                            text: item.status_tag;
                                                            font-family: Theme.font-mono;
                                                            font-size: Theme.fs-meta;
                                                            font-weight: 700;
                                                            color: item.status_idx == 1 ? Theme.green : (item.status_idx == 2 ? Theme.gold : Theme.axis-x);
                                                        }
                                                    }
                                                    Image {
                                                        vertical-stretch: 1;
                                                        source: item.thumb;
                                                        image-fit: contain;
                                                    }
                                                    Text {
                                                        text: item.name;
                                                        color: item.active ? Theme.text-primary : Theme.text-secondary;
                                                        font-size: Theme.fs-meta;
                                                        font-weight: item.active ? 600 : 500;
                                                        horizontal-alignment: center;
                                                        overflow: elide;
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    Hairline { }

                                    // Clean Curation Footer for Selected Clip (full words)
                                    HorizontalLayout {
                                        spacing: 4px;
                                        StudioButton { horizontal-stretch: 1; compact: true; ghost: true; label: "Aprobar"; active: root.active-clip-status == 1; clicked => { root.set-clip-status(root.featured-gallery-id, 1); } }
                                        StudioButton { horizontal-stretch: 1; compact: true; ghost: true; label: "Mejorar"; active: root.active-clip-status == 2; clicked => { root.set-clip-status(root.featured-gallery-id, 2); } }
                                        StudioButton { width: 66px; compact: true; ghost: true; label: "Descartar"; active: root.active-clip-status == 3; clicked => { root.set-clip-status(root.featured-gallery-id, 3); } }
                                    }
                                }

                                // VIEW B (Pinned mass curation): Same Weapon Catalog pinned inline (DEC-13)
                                if root.weapons-pinned : VerticalLayout {
                                    vertical-stretch: 1;
                                    padding: 10px;
                                    spacing: 8px;

                                    HorizontalLayout {
                                        alignment: space-between;
                                        SectionLabel {
                                            text: Theme.mono-headers ? "ARMAS (" + root.total-weapon-count + ")" : "Armas (" + root.total-weapon-count + ")";
                                            vertical-alignment: center;
                                        }
                                        HorizontalLayout {
                                            spacing: 4px;
                                            StudioButton { width: 66px; compact: true; ghost: true; label: "Importar"; clicked => { root.import-custom-weapons(); } }
                                            StudioButton { width: 58px; compact: true; active: true; label: "Fijado"; clicked => { root.weapons-pinned = false; } }
                                        }
                                    }

                                    Rectangle {
                                        height: 28px;
                                        border-radius: Theme.radius-control;
                                        background: Theme.wireframe-controls ? transparent : Theme.bg-input;
                                        border-width: 1px;
                                        border-color: pinned-w-search.has-focus ? Theme.accent : Theme.border-control;
                                        HorizontalLayout {
                                            padding-left: 8px; padding-right: 8px; spacing: 6px;
                                            VectorIcon {
                                                y: 7px; size: 13px; icon-color: Theme.text-dim;
                                                commands: "M11 4 A7 7 0 1 0 11 18 A7 7 0 1 0 11 4 Z M20 20 L16 16";
                                            }
                                            Rectangle {
                                                horizontal-stretch: 1; height: 28px; clip: true;
                                                if root.weapon-search == "" : Text {
                                                    width: parent.width; height: parent.height;
                                                    text: "Buscar ítem..."; color: Theme.text-dim; font-size: Theme.fs-body; vertical-alignment: center;
                                                }
                                                pinned-w-search := TextInput {
                                                    width: parent.width; height: parent.height;
                                                    text <=> root.weapon-search; color: Theme.text-primary; font-size: Theme.fs-body;
                                                    single-line: true; vertical-alignment: center;
                                                    changed has-focus => { root.text-input-active = self.has-focus; }
                                                    edited => { root.search-weapons(self.text); }
                                                }
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 4px;
                                        StudioButton {
                                            horizontal-stretch: 1; compact: true;
                                            label: root.selected-category < root.categories.length ? root.categories[root.selected-category].name : "Todas";
                                            clicked => { root.select-category(root.selected-category + 1 >= root.categories.length ? 0 : root.selected-category + 1); }
                                        }
                                        StudioButton {
                                            width: 82px; compact: true;
                                            active: root.weapon-status-filter > 0;
                                            label: root.weapon-status-filter == 0 ? "Todos"
                                                 : (root.weapon-status-filter == 1 ? "Pendiente"
                                                 : (root.weapon-status-filter == 2 ? "Aprobada"
                                                 : (root.weapon-status-filter == 3 ? "Mejorar" : "Descartada")));
                                            clicked => { root.filter-weapon-status(root.weapon-status-filter >= 4 ? 0 : root.weapon-status-filter + 1); }
                                        }
                                    }

                                    ListView {
                                        vertical-stretch: 1;
                                        for w in root.filtered-weapons : TouchArea {
                                            height: 28px; mouse-cursor: pointer;
                                            clicked => { root.select-weapon(w.index); }
                                            Rectangle {
                                                border-radius: Theme.radius-control;
                                                background: root.active-weapon-index == w.index ? Theme.bg-active : (parent.has-hover ? Theme.bg-hover : transparent);
                                                HorizontalLayout {
                                                    padding-left: 8px; padding-right: 6px; spacing: 8px;
                                                    Image { width: 16px; height: 16px; y: 6px; source: w.icon; image-rendering: pixelated; }
                                                    Text {
                                                        text: w.name;
                                                        color: root.active-weapon-index == w.index ? Theme.text-primary : Theme.text-secondary;
                                                        font-size: Theme.fs-body;
                                                        font-weight: root.active-weapon-index == w.index ? 600 : 400;
                                                        overflow: elide; vertical-alignment: center; horizontal-stretch: 1;
                                                    }
                                                    if w.status_tag != "" : Text {
                                                        text: w.status_tag; font-family: Theme.font-mono; font-size: Theme.fs-meta; font-weight: 700;
                                                        color: w.status_idx == 1 ? Theme.green : (w.status_idx == 2 ? Theme.gold : Theme.axis-x);
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    Hairline { }

                                    HorizontalLayout {
                                        spacing: 4px;
                                        StudioButton { horizontal-stretch: 1; compact: true; ghost: true; label: "Aprobar"; active: root.active-weapon-status == 1; clicked => { root.set-weapon-status(root.active-weapon-index, 1); } }
                                        StudioButton { horizontal-stretch: 1; compact: true; ghost: true; label: "Mejorar"; active: root.active-weapon-status == 2; clicked => { root.set-weapon-status(root.active-weapon-index, 2); } }
                                        StudioButton { width: 66px; compact: true; ghost: true; label: "Descartar"; active: root.active-weapon-status == 3; clicked => { root.set-weapon-status(root.active-weapon-index, 3); } }
                                    }
                                }
                            }
                        }

                        if !root.focus-mode : VerticalHairline { }

                        // CENTER HERO: EDGE-TO-EDGE 3D STAGE (DEC-11, DEC-14, DEC-15 — Zero dynamic drop-shadow-blur)
                        Rectangle {
                            horizontal-stretch: 1;
                            clip: true;

                            vp-area := TouchArea {
                                width: parent.width;
                                height: parent.height;
                                property <bool> dragging: false;

                                init => { root.viewport-resized(self.width / 1px, self.height / 1px); }
                                changed width => { root.viewport-resized(self.width / 1px, self.height / 1px); }
                                changed height => { root.viewport-resized(self.width / 1px, self.height / 1px); }

                                Image {
                                    width: parent.width;
                                    height: parent.height;
                                    source: root.main-viewport;
                                    image-fit: fill;
                                }

                                pointer-event(ev) => {
                                    let mx = self.mouse-x / 1px;
                                    let my = self.mouse-y / 1px;
                                    let w = self.width / 1px;
                                    let h = self.height / 1px;
                                    let btn = ev.button == PointerEventButton.right ? 1 : (ev.button == PointerEventButton.middle ? 2 : 0);
                                    if (ev.kind == PointerEventKind.down) {
                                        root.close-popovers();
                                        root-focus.focus();
                                        self.dragging = true;
                                        root.vp-pointer-down(mx, my, btn, ev.modifiers.shift || ev.modifiers.alt, ev.modifiers.control, w, h);
                                    } else if (ev.kind == PointerEventKind.move) {
                                        if (self.dragging) {
                                            root.vp-pointer-move(mx, my, ev.modifiers.shift || ev.modifiers.alt, ev.modifiers.control, w, h);
                                        } else {
                                            root.vp-pointer-hover(mx, my, w, h);
                                        }
                                    } else if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) {
                                        if (self.dragging) {
                                            self.dragging = false;
                                            root.vp-pointer-up(mx, my, ev.modifiers.shift || ev.modifiers.alt, w, h);
                                        }
                                    }
                                }
                                scroll-event(ev) => {
                                    let dy = ev.delta-y != 0px ? ev.delta-y : ev.delta-x;
                                    root.vp-wheel(self.mouse-x / 1px, self.mouse-y / 1px, self.width / 1px, self.height / 1px, dy / 1px);
                                    accept
                                }
                            }

                            // Top-Left Tool Rail: Move, Rotate, Scale + Hide/Show Gizmo (DEC-11)
                            Rectangle {
                                x: 12px;
                                y: 12px;
                                width: 36px;
                                height: 132px;
                                border-radius: Theme.radius-overlay;
                                background: Theme.bg-popover;
                                border-width: 1px;
                                border-color: Theme.border-control;

                                VerticalLayout {
                                    padding: 4px;
                                    spacing: 4px;
                                    // Mover (tool 4)
                                    ToolRailBtn {
                                        path-cmd: "M5 9 L2 12 L5 15 M9 5 L12 2 L15 5 M15 19 L12 22 L9 19 M19 9 L22 12 L19 15 M2 12 H22 M12 2 V22";
                                        active: root.active-tool == 4;
                                        clicked => { root.active-tool = 4; root.select-tool(4); }
                                    }
                                    // Rotar (tool 1)
                                    ToolRailBtn {
                                        path-cmd: "M21 12 A9 9 0 1 1 18.36 5.64 L21 8 M21 3 V8 H16";
                                        active: root.active-tool == 1;
                                        clicked => { root.active-tool = 1; root.select-tool(1); }
                                    }
                                    // Escalar (tool 2)
                                    ToolRailBtn {
                                        path-cmd: "M15 3 H21 V9 M9 21 H3 V15 M21 3 L14 10 M3 21 L10 14";
                                        active: root.active-tool == 2;
                                        clicked => { root.active-tool = 2; root.select-tool(2); }
                                    }
                                    Hairline { }
                                    // Toggle Gizmo visibility cleanly without mode traps
                                    ToolRailBtn {
                                        path-cmd: "M2 12 S5.5 5 12 5 S22 12 22 12 S18.5 19 12 19 S2 12 2 12 Z M12 9 A3 3 0 1 0 12 15 A3 3 0 1 0 12 9 Z";
                                        active: !root.show-gizmo;
                                        clicked => { root.toggle-gizmo(); }
                                    }
                                }
                            }

                            // Top-Right Monochrome Controls: [Cámara ▾] [Vista ▾] [⛶] (DEC-15, NO XYZ Triad box)
                            Rectangle {
                                x: parent.width - 198px;
                                y: 12px;
                                width: 186px;
                                height: 32px;
                                border-radius: Theme.radius-overlay;
                                background: Theme.bg-popover;
                                border-width: 1px;
                                border-color: Theme.border-control;

                                HorizontalLayout {
                                    padding: 3px;
                                    spacing: 2px;
                                    cam-hud-ta := TouchArea {
                                        width: 74px; height: 26px;
                                        mouse-cursor: pointer;
                                        clicked => {
                                            let next = !root.camera-menu-open;
                                            root.close-popovers();
                                            root.camera-menu-open = next;
                                        }
                                        Rectangle {
                                            border-radius: Theme.radius-control;
                                            background: root.camera-menu-open ? Theme.bg-active : (cam-hud-ta.has-hover ? Theme.bg-hover : transparent);
                                            border-width: (Theme.wireframe-controls && root.camera-menu-open) ? 1px : 0px;
                                            border-color: Theme.border-control;
                                            HorizontalLayout {
                                                padding-left: 8px; padding-right: 6px; spacing: 4px; alignment: center;
                                                Text {
                                                    text: "Cámara";
                                                    color: root.camera-menu-open ? Theme.text-primary : Theme.text-secondary;
                                                    font-size: Theme.fs-meta;
                                                    font-weight: 500;
                                                    vertical-alignment: center;
                                                }
                                                VectorIcon {
                                                    y: (parent.height - self.height) / 2 + 1px;
                                                    size: 10px;
                                                    icon-color: root.camera-menu-open ? Theme.text-primary : Theme.text-dim;
                                                    commands: "M6 9 L12 15 L18 9";
                                                }
                                            }
                                        }
                                    }
                                    view-hud-ta := TouchArea {
                                        width: 68px; height: 26px;
                                        mouse-cursor: pointer;
                                        clicked => {
                                            let next = !root.view-menu-open;
                                            root.close-popovers();
                                            root.view-menu-open = next;
                                        }
                                        Rectangle {
                                            border-radius: Theme.radius-control;
                                            background: root.view-menu-open ? Theme.bg-active : (view-hud-ta.has-hover ? Theme.bg-hover : transparent);
                                            border-width: (Theme.wireframe-controls && root.view-menu-open) ? 1px : 0px;
                                            border-color: Theme.border-control;
                                            HorizontalLayout {
                                                padding-left: 8px; padding-right: 6px; spacing: 4px; alignment: center;
                                                Text {
                                                    text: "Vista";
                                                    color: root.view-menu-open ? Theme.text-primary : Theme.text-secondary;
                                                    font-size: Theme.fs-meta;
                                                    font-weight: 500;
                                                    vertical-alignment: center;
                                                }
                                                VectorIcon {
                                                    y: (parent.height - self.height) / 2 + 1px;
                                                    size: 10px;
                                                    icon-color: root.view-menu-open ? Theme.text-primary : Theme.text-dim;
                                                    commands: "M6 9 L12 15 L18 9";
                                                }
                                            }
                                        }
                                    }
                                    Rectangle {
                                        width: 1px; height: 16px; y: 5px; background: Theme.divider;
                                    }
                                    IconActionBtn {
                                        width: 28px; height: 26px;
                                        icon-size: 14px;
                                        active: root.focus-mode;
                                        path-cmd: root.focus-mode
                                            ? "M8 3 V5 A2 2 0 0 1 6 7 H4 M20 7 H18 A2 2 0 0 1 16 5 V3 M16 21 V19 A2 2 0 0 1 18 17 H20 M4 17 H6 A2 2 0 0 1 8 19 V21"
                                            : "M8 3 H5 A2 2 0 0 0 3 5 V8 M21 8 V5 A2 2 0 0 0 19 3 H16 M16 21 H19 A2 2 0 0 0 21 19 V16 M3 16 V19 A2 2 0 0 0 5 21 H8";
                                        clicked => { root.close-popovers(); root.toggle-focus-mode(); }
                                    }
                                }
                            }

                            // Contextual Guard Banner (shown ONLY when active weapon is blocked for active clip)
                            if !root.active-clip-compatible : Rectangle {
                                x: (parent.width - self.width) / 2;
                                y: 52px;
                                width: min(parent.width - 120px, 500px);
                                height: 32px;
                                border-radius: Theme.radius-overlay;
                                background: #26180be8;
                                border-width: 1px;
                                border-color: #f59e0b99;
                                HorizontalLayout {
                                    padding-left: 12px; padding-right: 6px; spacing: 6px;
                                    Text {
                                        text: "Clip bloqueado para " + root.active-weapon-name + " · Permitido: " + root.active-clip-targets;
                                        color: #fde68a;
                                        font-size: Theme.fs-meta;
                                        font-weight: 600;
                                        overflow: elide;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                    StudioButton { width: 112px; compact: true; label: "Equipar compatible"; clicked => { root.equip-compatible-weapon(); } }
                                    StudioButton { width: 84px; compact: true; ghost: true; label: "+ Permitir"; clicked => { root.allow-active-weapon-family(); } }
                                }
                            }

                            // Bottom-Center Transport Overlay (ONLY shown in focus-mode when Timeline is hidden: DEC-14)
                            if root.focus-mode : Rectangle {
                                x: (parent.width - self.width) / 2;
                                y: parent.height - 48px;
                                width: 288px;
                                height: 34px;
                                border-radius: Theme.radius-overlay;
                                background: Theme.bg-popover;
                                border-width: 1px;
                                border-color: Theme.border-control;

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 4px;
                                    alignment: space-between;
                                    HorizontalLayout {
                                        spacing: 2px;
                                        alignment: center;
                                        IconActionBtn { path-cmd: "M19 20 L9 12 L19 4 V20 Z M5 19 V5"; clicked => { root.jump-kf(-1); } }
                                        IconActionBtn { path-cmd: "M15 18 L9 12 L15 6"; clicked => { root.step-frame(-1); } }
                                        IconActionBtn {
                                            primary: true; filled: true;
                                            optical-x: root.playing ? 0px : 1px;
                                            path-cmd: root.playing ? "M6 4 H10 V20 H6 Z M14 4 H18 V20 H14 Z" : "M6 4 L20 12 L6 20 V4 Z";
                                            clicked => { root.toggle-play(); }
                                        }
                                        IconActionBtn { path-cmd: "M9 18 L15 12 L9 6"; clicked => { root.step-frame(1); } }
                                        IconActionBtn { path-cmd: "M5 4 L15 12 L5 20 V4 Z M19 5 V19"; clicked => { root.jump-kf(1); } }
                                    }
                                    Text {
                                        text: root.current-frame + "/" + root.total-frames;
                                        color: Theme.text-primary;
                                        font-family: Theme.font-mono;
                                        font-size: Theme.fs-mono;
                                        vertical-alignment: center;
                                    }
                                    StudioButton { width: 42px; compact: true; ghost: true; mono: true; label: root.speed-label; clicked => { root.cycle-speed(); } }
                                }
                            }
                        }

                        if !root.focus-mode : VerticalHairline { }

                        // RIGHT INSPECTOR (272px): 2 Clean Tabs [Pose | Reglas y VFX] with Direct 8-Bone List (DEC-16)
                        Rectangle {
                            width: root.focus-mode ? 0px : 272px;
                            opacity: root.focus-mode ? 0.0 : 1.0;
                            visible: self.width > 4px;
                            clip: true;
                            background: Theme.bg-sidebar;
                            animate width { duration: Theme.dur-spatial; easing: spring(0.10); }
                            animate opacity { duration: Theme.dur-effects; easing: cubic-bezier(0, 0, 0, 1); }

                            VerticalLayout {
                                spacing: 0px;

                                // Clean 2-Tab Header with 2px Underline
                                Rectangle {
                                    height: 36px;
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        for t[ti] in ["Pose", "Reglas y VFX"] : TouchArea {
                                            horizontal-stretch: 1;
                                            mouse-cursor: pointer;
                                            clicked => { root.inspector-tab = ti; }
                                            Rectangle {
                                                Text {
                                                    text: Theme.mono-headers ? (ti == 0 ? "POSE" : "REGLAS Y VFX") : t;
                                                    color: root.inspector-tab == ti ? Theme.text-primary : Theme.text-secondary;
                                                    font-family: Theme.mono-headers ? Theme.font-mono : Theme.font-ui;
                                                    font-size: Theme.fs-body;
                                                    font-weight: root.inspector-tab == ti ? 600 : 500;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                                if root.inspector-tab == ti : Rectangle {
                                                    x: 12px;
                                                    y: parent.height - 2px;
                                                    width: parent.width - 24px;
                                                    height: 2px;
                                                    background: Theme.accent;
                                                }
                                            }
                                        }
                                    }
                                    Hairline { y: parent.height - 1px; width: parent.width; }
                                }

                                // TAB 0: POSE (Direct 8-Bone Skeleton + Active Bone Transform + Animation)
                                if root.inspector-tab == 0 : Flickable {
                                    vertical-stretch: 1;
                                    interactive: true;
                                    content-height: insp-pose-col.preferred-height;

                                    insp-pose-col := VerticalLayout {
                                        width: parent.width;
                                        alignment: start;
                                        padding: 12px;
                                        spacing: 11px;

                                        // 1. Direct 8-Bone Skeleton List (no extra tab, zero box nesting)
                                        VerticalLayout {
                                            spacing: 3px;
                                            HorizontalLayout {
                                                alignment: space-between;
                                                SectionLabel { text: Theme.mono-headers ? "ESQUELETO" : "Esqueleto"; vertical-alignment: center; }
                                                StudioButton { width: 72px; compact: true; ghost: true; label: "Ver todos"; clicked => { root.show-all-bones-reset(); } }
                                            }
                                            for b in root.all-bones-tracks : TouchArea {
                                                height: 22px;
                                                mouse-cursor: pointer;
                                                clicked => { root.select-bone-idx(b.bone_idx); }
                                                Rectangle {
                                                    border-radius: Theme.radius-control;
                                                    background: b.active ? Theme.bg-active : (parent.has-hover ? Theme.bg-hover : transparent);
                                                    HorizontalLayout {
                                                        padding-left: 8px; padding-right: 4px; spacing: 8px;
                                                        Rectangle { width: 6px; height: 6px; y: 8px; border-radius: 3px; background: b.dot_color; }
                                                        Text {
                                                            text: b.name;
                                                            color: b.active ? Theme.text-primary : (b.visible ? Theme.text-secondary : Theme.text-dim);
                                                            font-size: Theme.fs-body;
                                                            font-weight: b.active ? 600 : 400;
                                                            vertical-alignment: center;
                                                            horizontal-stretch: 1;
                                                        }
                                                        IconActionBtn {
                                                            width: 22px; height: 22px; icon-size: 13px;
                                                            path-cmd: b.visible
                                                                ? "M2 12 S5.5 5 12 5 S22 12 22 12 S18.5 19 12 19 S2 12 2 12 Z M12 9 A3 3 0 1 0 12 15 A3 3 0 1 0 12 9 Z"
                                                                : "M17.94 17.94 A10.07 10.07 0 0 1 12 20 C5 20 1 12 1 12 A18.45 18.45 0 0 1 5.06 5.94 M9.9 4.24 A9.12 9.12 0 0 1 12 4 C19 4 23 12 23 12 A18.5 18.5 0 0 1 20.84 15.17 M1 1 L23 23";
                                                            clicked => { root.toggle-bone-visible(b.bone_idx); }
                                                        }
                                                    }
                                                }
                                            }
                                        }

                                        Hairline { }

                                        // 2. Active Bone Transform + Pose Actions (Copy / Paste / Mirror / Reset)
                                        VerticalLayout {
                                            spacing: 8px;
                                            HorizontalLayout {
                                                alignment: space-between;
                                                Text { text: root.active-bone-name; color: Theme.text-primary; font-size: Theme.fs-title; font-weight: 600; vertical-alignment: center; overflow: elide; }
                                                HorizontalLayout {
                                                    spacing: 2px;
                                                    IconActionBtn { width: 24px; height: 24px; icon-size: 13px; path-cmd: "M9 9 H20 V20 H9 Z M5 15 H4 A2 2 0 0 1 2 13 V4 A2 2 0 0 1 4 2 H13 A2 2 0 0 1 15 4 V5"; clicked => { root.copy-bone-action(false); } }
                                                    IconActionBtn { width: 24px; height: 24px; icon-size: 13px; active: root.bone-clipboard-count > 0; path-cmd: "M16 4 H18 A2 2 0 0 1 20 6 V20 A2 2 0 0 1 18 22 H6 A2 2 0 0 1 4 20 V6 A2 2 0 0 1 6 4 H8 M8 2 H16 V6 H8 Z"; clicked => { root.paste-bone-action(false); } }
                                                    IconActionBtn { width: 24px; height: 24px; icon-size: 13px; path-cmd: "M8 3 H5 A2 2 0 0 0 3 5 V19 A2 2 0 0 0 5 21 H8 M16 3 H19 A2 2 0 0 1 21 5 V19 A2 2 0 0 1 19 21 H16 M12 20 V4"; clicked => { root.mirror-pose-action(); } }
                                                    IconActionBtn { width: 24px; height: 24px; icon-size: 13px; path-cmd: "M3 12 A9 9 0 1 0 5.64 5.64 L3 8 M3 3 V8 H8"; clicked => { root.reset-pose-action(); } }
                                                }
                                            }
                                            VerticalLayout {
                                                spacing: 3px;
                                                Text { text: "Posición (px)"; color: Theme.text-dim; font-size: Theme.fs-meta; }
                                                HorizontalLayout {
                                                    spacing: 4px;
                                                    AxisCell { axis: "X"; axis-color: Theme.axis-x; value-text: root.pos-x; step(d) => { root.step-bone-axis(0, 0, d); } scrub-start => { root.scrub-axis-start(); } scrub(dx) => { root.scrub-bone-axis(0, 0, dx); } reset-axis => { root.reset-bone-axis(0, 0); } }
                                                    AxisCell { axis: "Y"; axis-color: Theme.axis-y; value-text: root.pos-y; step(d) => { root.step-bone-axis(0, 1, d); } scrub-start => { root.scrub-axis-start(); } scrub(dx) => { root.scrub-bone-axis(0, 1, dx); } reset-axis => { root.reset-bone-axis(0, 1); } }
                                                    AxisCell { axis: "Z"; axis-color: Theme.axis-z; value-text: root.pos-z; step(d) => { root.step-bone-axis(0, 2, d); } scrub-start => { root.scrub-axis-start(); } scrub(dx) => { root.scrub-bone-axis(0, 2, dx); } reset-axis => { root.reset-bone-axis(0, 2); } }
                                                }
                                            }
                                            VerticalLayout {
                                                spacing: 3px;
                                                Text { text: "Rotación (°)"; color: Theme.text-dim; font-size: Theme.fs-meta; }
                                                HorizontalLayout {
                                                    spacing: 4px;
                                                    AxisCell { axis: "X"; axis-color: Theme.axis-x; value-text: root.rot-x; step(d) => { root.step-bone-axis(1, 0, d); } scrub-start => { root.scrub-axis-start(); } scrub(dx) => { root.scrub-bone-axis(1, 0, dx); } reset-axis => { root.reset-bone-axis(1, 0); } }
                                                    AxisCell { axis: "Y"; axis-color: Theme.axis-y; value-text: root.rot-y; step(d) => { root.step-bone-axis(1, 1, d); } scrub-start => { root.scrub-axis-start(); } scrub(dx) => { root.scrub-bone-axis(1, 1, dx); } reset-axis => { root.reset-bone-axis(1, 1); } }
                                                    AxisCell { axis: "Z"; axis-color: Theme.axis-z; value-text: root.rot-z; step(d) => { root.step-bone-axis(1, 2, d); } scrub-start => { root.scrub-axis-start(); } scrub(dx) => { root.scrub-bone-axis(1, 2, dx); } reset-axis => { root.reset-bone-axis(1, 2); } }
                                                }
                                            }
                                            VerticalLayout {
                                                spacing: 3px;
                                                Text { text: "Escala"; color: Theme.text-dim; font-size: Theme.fs-meta; }
                                                HorizontalLayout {
                                                    spacing: 4px;
                                                    AxisCell { axis: "X"; axis-color: Theme.axis-x; value-text: root.scl-x; step(d) => { root.step-bone-axis(2, 0, d); } scrub-start => { root.scrub-axis-start(); } scrub(dx) => { root.scrub-bone-axis(2, 0, dx); } reset-axis => { root.reset-bone-axis(2, 0); } }
                                                    AxisCell { axis: "Y"; axis-color: Theme.axis-y; value-text: root.scl-y; step(d) => { root.step-bone-axis(2, 1, d); } scrub-start => { root.scrub-axis-start(); } scrub(dx) => { root.scrub-bone-axis(2, 1, dx); } reset-axis => { root.reset-bone-axis(2, 1); } }
                                                    AxisCell { axis: "Z"; axis-color: Theme.axis-z; value-text: root.scl-z; step(d) => { root.step-bone-axis(2, 2, d); } scrub-start => { root.scrub-axis-start(); } scrub(dx) => { root.scrub-bone-axis(2, 2, dx); } reset-axis => { root.reset-bone-axis(2, 2); } }
                                                }
                                            }
                                        }

                                        Hairline { }

                                        // 3. Animation Timing & Easing
                                        VerticalLayout {
                                            spacing: 8px;
                                            SectionLabel { text: Theme.mono-headers ? "ANIMACIÓN" : "Animación"; }
                                            HorizontalLayout {
                                                alignment: space-between;
                                                Text { text: "Bucle continuo"; color: Theme.text-secondary; font-size: Theme.fs-body; vertical-alignment: center; }
                                                StudioSwitch { checked: root.anim-loop; toggled(v) => { root.toggle-loop(v); } }
                                            }
                                            HorizontalLayout {
                                                alignment: space-between;
                                                Text { text: "Duración"; color: Theme.text-secondary; font-size: Theme.fs-body; vertical-alignment: center; }
                                                HorizontalLayout {
                                                    spacing: 4px;
                                                    StudioButton { width: 24px; compact: true; ghost: true; label: "-"; clicked => { root.set-clip-frames(root.total-frames - 1); } }
                                                    Rectangle {
                                                        width: 82px; height: 24px; border-radius: Theme.radius-control;
                                                        background: Theme.wireframe-controls ? transparent : Theme.bg-input;
                                                        border-width: 1px; border-color: Theme.border-control;
                                                        Text { text: root.total-frames + "f · " + root.duration-text + "s"; color: Theme.text-primary; font-family: Theme.font-mono; font-size: Theme.fs-meta; horizontal-alignment: center; vertical-alignment: center; }
                                                    }
                                                    StudioButton { width: 24px; compact: true; ghost: true; label: "+"; clicked => { root.set-clip-frames(root.total-frames + 1); } }
                                                }
                                            }
                                            HorizontalLayout {
                                                spacing: 3px;
                                                for fc in [15, 30, 60, 90, 120] : StudioButton {
                                                    compact: true;
                                                    horizontal-stretch: 1;
                                                    mono: true;
                                                    label: fc + "f";
                                                    active: root.total-frames == fc;
                                                    clicked => { root.set-clip-frames(fc); }
                                                }
                                            }
                                            HorizontalLayout {
                                                spacing: 3px;
                                                for e[ei] in ["Snap", "Peso", "Suave", "Lineal"] : StudioButton {
                                                    compact: true;
                                                    horizontal-stretch: 1;
                                                    label: e;
                                                    active: root.easing-idx == ei;
                                                    clicked => { root.set-easing(ei); }
                                                }
                                            }
                                        }
                                    }
                                }

                                // TAB 1: REGLAS DE OBJETOS & VFX
                                if root.inspector-tab == 1 : Flickable {
                                    vertical-stretch: 1;
                                    interactive: true;
                                    content-height: max(self.height, insp-vfx-col.preferred-height);

                                    insp-vfx-col := VerticalLayout {
                                        width: parent.width;
                                        padding: 12px;
                                        spacing: 12px;

                                        VerticalLayout {
                                            spacing: 6px;
                                            HorizontalLayout {
                                                alignment: space-between;
                                                SectionLabel { text: Theme.mono-headers ? "OBJETOS PERMITIDOS" : "Objetos Permitidos"; vertical-alignment: center; }
                                                Text {
                                                    text: root.active-clip-compatible ? "Compatible" : "Bloqueado";
                                                    color: root.active-clip-compatible ? Theme.green : Theme.gold;
                                                    font-family: Theme.font-mono;
                                                    font-size: Theme.fs-meta;
                                                    font-weight: 700;
                                                }
                                            }
                                            HorizontalLayout {
                                                spacing: 4px;
                                                StudioButton { compact: true; horizontal-stretch: 1; label: "Universal"; active: root.active-clip-universal; clicked => { root.set-clip-universal(); } }
                                                StudioButton { compact: true; horizontal-stretch: 1; label: "Solo esta arma"; active: root.active-clip-only-current; clicked => { root.toggle-clip-only-current-weapon(); } }
                                            }
                                            for row in root.clip-family-rows : HorizontalLayout {
                                                spacing: 4px;
                                                StudioButton { compact: true; horizontal-stretch: 1; label: row.left_label; active: row.left_on; clicked => { root.toggle-clip-family(row.left_idx); } }
                                                StudioButton { compact: true; horizontal-stretch: 1; label: row.right_label; active: row.right_on; clicked => { root.toggle-clip-family(row.right_idx); } }
                                            }
                                        }

                                        Hairline { }

                                        VerticalLayout {
                                            spacing: 6px;
                                            HorizontalLayout {
                                                alignment: space-between;
                                                SectionLabel { text: Theme.mono-headers ? "IMPACTO Y VFX" : "Impacto y VFX"; vertical-alignment: center; }
                                                Text { text: root.impact-time-text; color: Theme.gold; font-family: Theme.font-mono; font-size: Theme.fs-meta; font-weight: 700; }
                                            }
                                            HorizontalLayout {
                                                spacing: 4px;
                                                StudioButton { horizontal-stretch: 1; compact: true; label: "Marcar impacto aquí"; clicked => { root.mark-impact-action(); } }
                                            }
                                            HorizontalLayout {
                                                spacing: 3px;
                                                for vk[vi] in ["Estela", "Parry", "Sonar", "Stop", "Shake"] : StudioButton {
                                                    compact: true; font-size: Theme.fs-meta; horizontal-stretch: 1;
                                                    label: vk; active: root.new-vfx-kind == vi; clicked => { root.new-vfx-kind = vi; }
                                                }
                                            }
                                            HorizontalLayout {
                                                spacing: 3px;
                                                for vc[ci] in ["Violeta", "Dorado", "Cian", "Rojo"] : StudioButton {
                                                    compact: true; font-size: Theme.fs-meta; horizontal-stretch: 1;
                                                    label: vc; active: root.new-vfx-color-idx == ci; clicked => { root.new-vfx-color-idx = ci; }
                                                }
                                            }
                                            StudioButton { label: "+ Añadir VFX en Playhead"; primary: true; clicked => { root.add-vfx-event(root.new-vfx-kind, root.new-vfx-color-idx); } }

                                            for ev in root.clip-vfx-events : HorizontalLayout {
                                                height: 24px; spacing: 4px;
                                                TouchArea {
                                                    horizontal-stretch: 1; mouse-cursor: pointer;
                                                    clicked => { root.jump-to-vfx-event(ev.index); }
                                                    Rectangle {
                                                        border-radius: Theme.radius-control;
                                                        background: parent.has-hover ? Theme.bg-hover : transparent;
                                                        HorizontalLayout {
                                                            padding-left: 6px; padding-right: 6px; spacing: 6px;
                                                            Text { text: ev.time_text; color: Theme.gold; font-family: Theme.font-mono; font-size: Theme.fs-mono; vertical-alignment: center; }
                                                            Text { text: ev.kind_label; color: Theme.text-primary; font-size: Theme.fs-body; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                                        }
                                                    }
                                                }
                                                IconActionBtn {
                                                    width: 24px; height: 24px; icon-size: 12px;
                                                    path-cmd: "M18 6 L6 18 M6 6 L18 18";
                                                    clicked => { root.remove-vfx-event(ev.index); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    if !root.focus-mode : Hairline { }

                    // ==================== PIEZA #4: SINGLE UNIFIED 156PX TIMELINE (DEC-14, DEC-17) ====================
                    Rectangle {
                        height: root.focus-mode ? 0px : 156px;
                        opacity: root.focus-mode ? 0.0 : 1.0;
                        visible: self.height > 4px;
                        clip: true;
                        background: Theme.bg-sidebar;
                        animate height { duration: Theme.dur-spatial; easing: spring(0.10); }
                        animate opacity { duration: Theme.dur-effects; easing: cubic-bezier(0, 0, 0, 1); }

                        VerticalLayout {
                            spacing: 0px;

                            // Row 1 (32px): Left Pistas + Auto | Center Vector Transport | Right 4 Clean KF Actions
                            Rectangle {
                                height: 32px;
                                background: Theme.bg-ruler;

                                // Left 244px Pistas + Zoom [- 1.0x +] + ● Auto
                                HorizontalLayout {
                                    x: 0px;
                                    width: 244px;
                                    height: 32px;
                                    padding-left: 12px;
                                    padding-right: 8px;
                                    alignment: space-between;

                                    SectionLabel {
                                        text: Theme.mono-headers ? "PISTAS" : "Pistas";
                                        vertical-alignment: center;
                                    }

                                    HorizontalLayout {
                                        y: 5px;
                                        height: 22px;
                                        spacing: 2px;
                                        StudioButton {
                                            width: 18px; height: 22px; compact: true; ghost: true; label: "-";
                                            clicked => { root.zoom-timeline(-1.0, 0.5); }
                                        }
                                        zoom-reset-ta := TouchArea {
                                            width: 34px; height: 22px; mouse-cursor: pointer;
                                            clicked => { root.reset-timeline-zoom(); }
                                            Rectangle {
                                                border-radius: Theme.radius-control;
                                                background: root.timeline-zoomed ? Theme.accent-soft : (zoom-reset-ta.has-hover ? Theme.bg-hover : transparent);
                                                Text {
                                                    text: root.timeline-zoom-label;
                                                    color: root.timeline-zoomed ? Theme.accent-text : Theme.text-dim;
                                                    font-family: Theme.font-mono;
                                                    font-size: Theme.fs-meta;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                        StudioButton {
                                            width: 18px; height: 22px; compact: true; ghost: true; label: "+";
                                            clicked => { root.zoom-timeline(1.0, 0.5); }
                                        }
                                    }

                                    auto-ta := TouchArea {
                                        width: 64px;
                                        height: 24px;
                                        y: 4px;
                                        mouse-cursor: pointer;
                                        clicked => { root.toggle-auto-kf(!root.auto-keyframe); }
                                        Rectangle {
                                            border-radius: Theme.radius-control;
                                            background: root.auto-keyframe ? Theme.bg-active : (auto-ta.has-hover ? Theme.bg-hover : transparent);
                                            border-width: root.auto-keyframe ? 1px : 0px;
                                            border-color: Theme.border-control;
                                            HorizontalLayout {
                                                padding-left: 7px; padding-right: 7px; spacing: 5px; alignment: center;
                                                Rectangle {
                                                    width: 6px; height: 6px; y: 9px; border-radius: 3px;
                                                    background: root.auto-keyframe ? Theme.axis-x : Theme.text-dim;
                                                }
                                                Text {
                                                    text: "Auto";
                                                    color: root.auto-keyframe ? Theme.text-primary : Theme.text-secondary;
                                                    font-size: Theme.fs-meta;
                                                    font-weight: 600;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }

                                // Center Vector Media Transport (DEC-14)
                                HorizontalLayout {
                                    x: (parent.width - 280px) / 2 + 122px;
                                    y: 3px;
                                    width: 280px;
                                    height: 26px;
                                    spacing: 4px;
                                    alignment: center;

                                    IconActionBtn { path-cmd: "M19 20 L9 12 L19 4 V20 Z M5 19 V5"; clicked => { root.jump-kf(-1); } }
                                    IconActionBtn { path-cmd: "M15 18 L9 12 L15 6"; clicked => { root.step-frame(-1); } }
                                    IconActionBtn {
                                        primary: true; filled: true;
                                        optical-x: root.playing ? 0px : 1px;
                                        path-cmd: root.playing ? "M6 4 H10 V20 H6 Z M14 4 H18 V20 H14 Z" : "M6 4 L20 12 L6 20 V4 Z";
                                        clicked => { root.toggle-play(); }
                                    }
                                    IconActionBtn { path-cmd: "M9 18 L15 12 L9 6"; clicked => { root.step-frame(1); } }
                                    IconActionBtn { path-cmd: "M5 4 L15 12 L5 20 V4 Z M19 5 V19"; clicked => { root.jump-kf(1); } }

                                    Text {
                                        text: root.current-frame + "/" + root.total-frames;
                                        color: Theme.text-primary;
                                        font-family: Theme.font-mono;
                                        font-size: Theme.fs-mono;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                    StudioButton { width: 42px; compact: true; ghost: true; mono: true; label: root.speed-label; clicked => { root.cycle-speed(); } }
                                }

                                // Right Scope Switch (Hueso | Todo) + Keyframe Actions (Copy, Paste, Add, Impact, Delete)
                                HorizontalLayout {
                                    x: parent.width - 274px;
                                    y: 3px;
                                    width: 266px;
                                    height: 26px;
                                    spacing: 4px;
                                    alignment: end;

                                    if root.selected-range-count > 1 : Rectangle {
                                        width: 28px;
                                        height: 22px;
                                        y: 2px;
                                        border-radius: Theme.radius-control;
                                        background: Theme.accent-soft;
                                        border-width: 1px;
                                        border-color: Theme.accent;
                                        Text {
                                            text: root.selected-range-count + "f";
                                            color: Theme.accent-text;
                                            font-family: Theme.font-mono;
                                            font-size: Theme.fs-meta;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    // Scope Pill: Hueso vs Todo (DEC-18)
                                    Rectangle {
                                        width: 92px;
                                        height: 22px;
                                        y: 2px;
                                        border-radius: Theme.radius-control;
                                        background: Theme.bg-input;
                                        border-width: 1px;
                                        border-color: Theme.border-control;

                                        HorizontalLayout {
                                            padding: 2px;
                                            spacing: 2px;
                                            for sc[si] in ["Hueso", "Todo"] : TouchArea {
                                                horizontal-stretch: 1;
                                                mouse-cursor: pointer;
                                                clicked => { root.set-timeline-bone-scope(si == 0); }
                                                Rectangle {
                                                    border-radius: max(0px, Theme.radius-control - 1px);
                                                    background: (si == 0 ? root.timeline-bone-scope : !root.timeline-bone-scope) ? Theme.bg-active : transparent;
                                                    Text {
                                                        text: sc;
                                                        color: (si == 0 ? root.timeline-bone-scope : !root.timeline-bone-scope) ? Theme.text-primary : Theme.text-dim;
                                                        font-size: Theme.fs-meta;
                                                        font-weight: (si == 0 ? root.timeline-bone-scope : !root.timeline-bone-scope) ? 600 : 500;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    Rectangle { width: 1px; height: 14px; y: 6px; background: Theme.divider; }

                                    IconActionBtn { width: 24px; height: 24px; icon-size: 13px; path-cmd: "M9 9 H20 V20 H9 Z M5 15 H4 A2 2 0 0 1 2 13 V4 A2 2 0 0 1 4 2 H13 A2 2 0 0 1 15 4 V5"; clicked => { root.copy-timeline-action(); } }
                                    IconActionBtn { width: 24px; height: 24px; icon-size: 13px; active: root.bone-clipboard-count > 0; path-cmd: "M16 4 H18 A2 2 0 0 1 20 6 V20 A2 2 0 0 1 18 22 H6 A2 2 0 0 1 4 20 V6 A2 2 0 0 1 6 4 H8 M8 2 H16 V6 H8 Z"; clicked => { root.paste-timeline-action(); } }
                                    IconActionBtn { width: 24px; height: 24px; icon-size: 13px; path-cmd: "M12 5 V19 M5 12 H19"; clicked => { root.add-keyframe-action(); } }
                                    IconActionBtn { width: 24px; height: 24px; icon-size: 13px; active: root.has-impact; path-cmd: "M13 2 L3 14 H12 L11 22 L21 10 H12 L13 2 Z"; clicked => { root.mark-impact-action(); } }
                                    IconActionBtn { width: 24px; height: 24px; icon-size: 13px; path-cmd: "M3 6 H21 M19 6 V20 A2 2 0 0 1 17 22 H7 A2 2 0 0 1 5 20 V6 M8 6 V4 A2 2 0 0 1 10 2 H14 A2 2 0 0 1 16 4 V6"; clicked => { root.delete-keyframe-action(); } }
                                }
                            }

                            Hairline { }

                            // Row 2 (24px): Left Bone Count Toggle ("4 huesos" / "Todos (8)") | Graduated Scrubbable Frame Ruler
                            Rectangle {
                                height: 24px;
                                background: Theme.bg-ruler;

                                HorizontalLayout {
                                    spacing: 0px;
                                    Rectangle {
                                        width: 244px;
                                        bones-toggle-ta := TouchArea {
                                            width: parent.width;
                                            height: parent.height;
                                            mouse-cursor: pointer;
                                            clicked => { root.toggle-all-bones(); }
                                            Rectangle {
                                                background: bones-toggle-ta.has-hover ? Theme.bg-hover : transparent;
                                                HorizontalLayout {
                                                    padding-left: 12px; padding-right: 10px; alignment: space-between;
                                                    Text {
                                                        text: root.show-all-bones ? "Todos (8 huesos)" : "4 huesos principales";
                                                        color: Theme.text-secondary;
                                                        font-size: Theme.fs-meta;
                                                        font-weight: 500;
                                                        vertical-alignment: center;
                                                    }
                                                    VectorIcon {
                                                        y: 6px; size: 12px; icon-color: Theme.text-dim;
                                                        commands: root.show-all-bones ? "M18 15 L12 9 L6 15" : "M6 9 L12 15 L18 9";
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    VerticalHairline { }

                                    ruler-touch := TouchArea {
                                        horizontal-stretch: 1;
                                        mouse-cursor: pointer;
                                        property <bool> scrubbing: false;
                                        property <bool> panning: false;
                                        property <float> pan-last-x: 0;
                                        pointer-event(ev) => {
                                            let mx = self.mouse-x / 1px;
                                            let lane_w = max(1.0, (self.width / 1px) - 20.0);
                                            let f = clamp((mx - 10.0) / lane_w, 0.0, 1.0);
                                            if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                                                root-focus.focus();
                                                self.scrubbing = true;
                                                root.scrub-timeline(f);
                                            } else if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.middle) {
                                                root-focus.focus();
                                                self.panning = true;
                                                self.pan-last-x = mx;
                                            } else if (ev.kind == PointerEventKind.move && self.scrubbing) {
                                                root.scrub-timeline(f);
                                            } else if (ev.kind == PointerEventKind.move && self.panning) {
                                                root.pan-timeline(-(mx - self.pan-last-x) / lane_w);
                                                self.pan-last-x = mx;
                                            } else if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) {
                                                self.scrubbing = false;
                                                self.panning = false;
                                            }
                                        }
                                        scroll-event(ev) => {
                                            let lane_w = max(1.0, (self.width / 1px) - 20.0);
                                            let anchor = clamp((self.mouse-x / 1px - 10.0) / lane_w, 0.0, 1.0);
                                            let dx = ev.delta-x / 1px;
                                            let dy = ev.delta-y / 1px;
                                            if (abs(dx) > 0.0 || root.shift-held) {
                                                let d = abs(dx) > 0.0 ? -dx : -dy;
                                                root.pan-timeline(d / 640.0);
                                                return accept;
                                            }
                                            if (abs(dy) > 0.0) {
                                                root.zoom-timeline(dy, anchor);
                                                return accept;
                                            }
                                            reject
                                        }

                                        // Single 1:1 physical-pixel ruler texture (notches + mono digits = zero dynamic Text overhead)
                                        Image {
                                            x: 10px;
                                            y: 0px;
                                            width: max(1px, parent.width - 20px);
                                            height: parent.height;
                                            source: root.ruler-notches-img;
                                            image-fit: fill;
                                            image-rendering: pixelated;
                                        }

                                        // Ruler Playhead Handle Cap
                                        if root.playhead-visible : Rectangle {
                                            x: root.playhead-frac * (parent.width - 20px) + 6px;
                                            y: parent.height - 6px;
                                            width: 9px;
                                            height: 6px;
                                            border-radius: min(2px, Theme.radius-control);
                                            background: Theme.accent;
                                        }
                                    }
                                }
                            }

                            Hairline { }

                            // Row 3 (100px): 4 Primary Tracks Unclipped (or Smooth Scroll for 8 Bones)
                            Flickable {
                                vertical-stretch: 1;
                                interactive: root.show-all-bones;
                                content-height: max(self.height, root.timeline-tracks.length * 24px + 4px);

                                HorizontalLayout {
                                    width: parent.width;
                                    height: max(parent.height, root.timeline-tracks.length * 24px + 4px);
                                    spacing: 0px;

                                    Rectangle {
                                        width: 244px;
                                        background: Theme.bg-sidebar;
                                        VerticalLayout {
                                            padding: 2px;
                                            spacing: 2px;
                                            for tr in root.timeline-tracks : TouchArea {
                                                height: 22px;
                                                mouse-cursor: pointer;
                                                pointer-event(ev) => {
                                                    if (ev.kind == PointerEventKind.down) {
                                                        root-focus.focus();
                                                        root.select-bone-idx(tr.bone_idx);
                                                        if (ev.button == PointerEventButton.right) {
                                                            root.close-popovers();
                                                            root.timeline-ctx-bone-idx = tr.bone_idx;
                                                            root.timeline-ctx-bone-name = tr.name;
                                                            root.timeline-ctx-x = clamp(self.absolute-position.x + self.mouse-x, 12px, root.width - 284px);
                                                            root.timeline-ctx-open = true;
                                                        }
                                                    }
                                                }
                                                Rectangle {
                                                    border-radius: Theme.radius-control;
                                                    background: tr.active ? Theme.bg-active : (parent.has-hover ? Theme.bg-hover : transparent);
                                                    HorizontalLayout {
                                                        padding-left: 10px; padding-right: 6px; spacing: 8px;
                                                        Rectangle { width: 6px; height: 6px; y: 8px; border-radius: 3px; background: tr.dot_color; }
                                                        Text {
                                                            text: tr.name;
                                                            color: tr.active ? Theme.text-primary : (tr.visible ? Theme.text-secondary : Theme.text-dim);
                                                            font-size: Theme.fs-body;
                                                            font-weight: tr.active ? 600 : 400;
                                                            vertical-alignment: center;
                                                            horizontal-stretch: 1;
                                                        }
                                                        IconActionBtn {
                                                            width: 22px; height: 22px; icon-size: 13px;
                                                            path-cmd: tr.visible
                                                                ? "M2 12 S5.5 5 12 5 S22 12 22 12 S18.5 19 12 19 S2 12 2 12 Z M12 9 A3 3 0 1 0 12 15 A3 3 0 1 0 12 9 Z"
                                                                : "M17.94 17.94 A10.07 10.07 0 0 1 12 20 C5 20 1 12 1 12 A18.45 18.45 0 0 1 5.06 5.94 M9.9 4.24 A9.12 9.12 0 0 1 12 4 C19 4 23 12 23 12 A18.5 18.5 0 0 1 20.84 15.17 M1 1 L23 23";
                                                            clicked => { root.toggle-bone-visible(tr.bone_idx); }
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    VerticalHairline { }

                                    Rectangle {
                                        horizontal-stretch: 1;
                                        clip: true;

                                        lanes-area := TouchArea {
                                            width: parent.width;
                                            height: parent.height;
                                            property <bool> dragging-playhead: false;
                                            property <bool> panning: false;
                                            property <float> pan-last-x: 0;

                                            pointer-event(ev) => {
                                                let mx = self.mouse-x / 1px;
                                                let lane_w = max(1.0, (self.width / 1px) - 20.0);
                                                let f = clamp((mx - 10.0) / lane_w, 0.0, 1.0);
                                                if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                                                    root-focus.focus();
                                                    self.dragging-playhead = true;
                                                    root.scrub-timeline(f);
                                                } else if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.middle) {
                                                    root-focus.focus();
                                                    self.panning = true;
                                                    self.pan-last-x = mx;
                                                } else if (ev.kind == PointerEventKind.move && self.dragging-playhead) {
                                                    root.scrub-timeline(f);
                                                } else if (ev.kind == PointerEventKind.move && self.panning) {
                                                    root.pan-timeline(-(mx - self.pan-last-x) / lane_w);
                                                    self.pan-last-x = mx;
                                                } else if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) {
                                                    self.dragging-playhead = false;
                                                    self.panning = false;
                                                }
                                            }
                                            scroll-event(ev) => {
                                                let lane_w = max(1.0, (self.width / 1px) - 20.0);
                                                let anchor = clamp((self.mouse-x / 1px - 10.0) / lane_w, 0.0, 1.0);
                                                let dx = ev.delta-x / 1px;
                                                let dy = ev.delta-y / 1px;
                                                if (abs(dx) > 0.0 || root.shift-held) {
                                                    let d = abs(dx) > 0.0 ? -dx : -dy;
                                                    root.pan-timeline(d / 640.0);
                                                    return accept;
                                                }
                                                if (abs(dy) > 0.0 && (!root.show-all-bones || root.ctrl-held)) {
                                                    root.zoom-timeline(dy, anchor);
                                                    return accept;
                                                }
                                                reject
                                            }

                                            // Vertical per-frame guide lines texture aligned 1:1 with Ruler notches
                                            Image {
                                                x: 10px;
                                                y: 0px;
                                                width: max(1px, parent.width - 20px);
                                                height: parent.height;
                                                source: root.lanes-grid-img;
                                                image-fit: fill;
                                                image-rendering: pixelated;
                                            }

                                            for tr[ti] in root.timeline-tracks : Rectangle {
                                                x: 0px;
                                                y: 2px + ti * 24px + 11px;
                                                width: parent.width;
                                                height: 1px;
                                                background: Theme.bg-guide;
                                            }

                                            if root.has-impact && root.impact-visible : Rectangle {
                                                x: root.impact-frac * (parent.width - 20px) + 10px;
                                                y: 2px;
                                                width: 2px;
                                                height: parent.height - 4px;
                                                background: Theme.gold;
                                                opacity: 0.55;
                                            }

                                            if root.selected-range-track-idx >= 0 && root.selected-range-count > 1 : Rectangle {
                                                x: root.selected-range-start-frac * (parent.width - 20px) + 8px;
                                                y: 2px + root.selected-range-track-idx * 24px + 3px;
                                                width: max(12px, (root.selected-range-end-frac - root.selected-range-start-frac) * (parent.width - 20px) + 4px);
                                                height: 16px;
                                                border-radius: 3px;
                                                background: Theme.accent-soft;
                                            }

                                            for dm in root.timeline-diamonds : TouchArea {
                                                x: dm.frac * (parent.width - 20px) + 10px - 7px;
                                                y: 2px + dm.track_idx * 24px + 4px;
                                                width: 14px;
                                                height: 14px;
                                                mouse-cursor: ew-resize;
                                                property <bool> dragging-dm: false;
                                                property <float> press-x: 0;
                                                pointer-event(ev) => {
                                                    let mx = self.mouse-x / 1px;
                                                    if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                                                        root-focus.focus();
                                                        self.dragging-dm = !root.shift-held;
                                                        self.press-x = (self.x / 1px) + mx;
                                                        root.click-diamond(dm.kf_idx, dm.track_idx, root.shift-held);
                                                    } else if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.right) {
                                                        root-focus.focus();
                                                        root.click-diamond(dm.kf_idx, dm.track_idx, false);
                                                        root.close-popovers();
                                                        root.timeline-ctx-bone-idx = root.active-bone-idx;
                                                        root.timeline-ctx-bone-name = root.active-bone-name;
                                                        root.timeline-ctx-x = clamp(self.absolute-position.x + self.mouse-x, 12px, root.width - 284px);
                                                        root.timeline-ctx-open = true;
                                                    } else if (ev.kind == PointerEventKind.move && self.dragging-dm) {
                                                        let abs_x = (self.x / 1px) + mx;
                                                        if (abs(abs_x - self.press-x) > 2.5) {
                                                            let lane_w = max(1.0, (lanes-area.width / 1px) - 20.0);
                                                            let new_f = clamp((abs_x - 10.0) / lane_w, 0.0, 1.0);
                                                            root.drag-diamond(dm.kf_idx, new_f);
                                                        }
                                                    } else if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) {
                                                        self.dragging-dm = false;
                                                    }
                                                }
                                                Path {
                                                    width: 11px; height: 11px; x: 1.5px; y: 1.5px; viewbox-width: 12; viewbox-height: 12;
                                                    fill: dm.is_selected ? #ffffff : (dm.is_impact ? Theme.gold : dm.dot_color);
                                                    stroke: Theme.bg-shell;
                                                    stroke-width: 1px;
                                                    commands: "M6 1 L11 6 L6 11 L1 6 Z";
                                                }
                                            }

                                            // Accent Playhead Line
                                            if root.playhead-visible : Rectangle {
                                                x: root.playhead-frac * (parent.width - 20px) + 10px;
                                                y: 0px;
                                                width: 1.5px;
                                                height: parent.height;
                                                background: Theme.accent;
                                            }

                                            // Horizontal Pan Scrollbar when Timeline is zoomed (>1.0x)
                                            if root.timeline-zoomed : Rectangle {
                                                x: 10px;
                                                y: parent.height - 5px;
                                                width: max(1px, parent.width - 20px);
                                                height: 4px;
                                                border-radius: 2px;
                                                background: Theme.bg-guide;
                                                TouchArea {
                                                    width: 100%; height: 100%; mouse-cursor: pointer;
                                                    property <bool> dragging-sb: false;
                                                    pointer-event(ev) => {
                                                        let f = clamp((self.mouse-x / 1px) / max(1.0, self.width / 1px) - root.timeline-view-span * 0.5, 0.0, 1.0 - root.timeline-view-span);
                                                        if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                                                            self.dragging-sb = true;
                                                            root.set-timeline-view-start(f);
                                                        } else if (ev.kind == PointerEventKind.move && self.dragging-sb) {
                                                            root.set-timeline-view-start(f);
                                                        } else if (ev.kind == PointerEventKind.up || ev.kind == PointerEventKind.cancel) {
                                                            self.dragging-sb = false;
                                                        }
                                                    }
                                                }
                                                Rectangle {
                                                    x: root.timeline-view-start * parent.width;
                                                    y: 0px;
                                                    width: max(20px, root.timeline-view-span * parent.width);
                                                    height: 4px;
                                                    border-radius: 2px;
                                                    background: Theme.accent;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ==================== POPOVER BACKDROP DISMISS LAYER ====================
        if root.file-menu-open || root.clip-switcher-open || root.weapon-picker-open
            || root.camera-menu-open || root.view-menu-open || root.timeline-ctx-open : TouchArea {
            width: 100%;
            height: 100%;
            clicked => { root.close-popovers(); }
        }

        // 0. POPOVER: TIMELINE BONE CONTEXT MENU (Right-click on Track or Diamond)
        if root.timeline-ctx-open : Rectangle {
            x: root.timeline-ctx-x;
            y: root.height - 160px - 332px;
            width: 272px;
            height: 326px;
            border-radius: Theme.radius-overlay;
            background: Theme.bg-popover;
            border-width: 1px;
            border-color: Theme.border-control;

            TouchArea { width: 100%; height: 100%; }
            VerticalLayout {
                padding: 6px;
                spacing: 2px;

                HorizontalLayout {
                    height: 24px;
                    padding-left: 10px;
                    padding-right: 10px;
                    alignment: space-between;
                    Text { text: root.timeline-ctx-bone-name; color: Theme.text-primary; font-size: Theme.fs-meta; font-weight: 700; vertical-alignment: center; }
                    if root.bone-clipboard-count > 0 : Text { text: root.bone-clipboard-label; color: Theme.accent-text; font-family: Theme.font-mono; font-size: Theme.fs-meta; vertical-alignment: center; }
                }
                Hairline { }

                for mi in [
                    { id: "copy_f", lbl: "Copiar frame(s) del hueso", sc: "Ctrl+C" },
                    { id: "copy_tr", lbl: "Copiar toda la pista del hueso", sc: "" },
                    { id: "paste", lbl: "Pegar en este hueso aquí", sc: "Ctrl+V" },
                    { id: "paste_mir", lbl: "Pegar espejado en este hueso", sc: "" },
                    { id: "dup", lbl: "Duplicar frame del hueso (+0.10s)", sc: "" },
                ] : TouchArea {
                    height: 26px; mouse-cursor: pointer;
                    clicked => {
                        root.close-popovers();
                        if (mi.id == "copy_f") { root.copy-bone-action(false); }
                        else if (mi.id == "copy_tr") { root.copy-bone-action(true); }
                        else if (mi.id == "paste") { root.paste-bone-action(false); }
                        else if (mi.id == "paste_mir") { root.paste-bone-action(true); }
                        else if (mi.id == "dup") { root.dup-kf-next(); }
                    }
                    Rectangle {
                        border-radius: Theme.radius-control;
                        background: parent.has-hover ? Theme.bg-hover : transparent;
                        HorizontalLayout {
                            padding-left: 10px; padding-right: 10px; alignment: space-between;
                            Text { text: mi.lbl; color: Theme.text-primary; font-size: Theme.fs-body; vertical-alignment: center; }
                            if mi.sc != "" : Text { text: mi.sc; color: Theme.text-dim; font-family: Theme.font-mono; font-size: Theme.fs-meta; vertical-alignment: center; }
                        }
                    }
                }
                Hairline { }

                for md in [
                    { id: "del_f", lbl: "Borrar frame(s) de este hueso", sc: "Supr" },
                    { id: "del_tr", lbl: "Limpiar toda la pista del hueso", sc: "" },
                ] : TouchArea {
                    height: 26px; mouse-cursor: pointer;
                    clicked => {
                        root.close-popovers();
                        if (md.id == "del_f") { root.delete-bone-action(false); }
                        else if (md.id == "del_tr") { root.delete-bone-action(true); }
                    }
                    Rectangle {
                        border-radius: Theme.radius-control;
                        background: parent.has-hover ? Theme.bg-hover : transparent;
                        HorizontalLayout {
                            padding-left: 10px; padding-right: 10px; alignment: space-between;
                            Text { text: md.lbl; color: Theme.axis-x; font-size: Theme.fs-body; vertical-alignment: center; }
                            if md.sc != "" : Text { text: md.sc; color: Theme.text-dim; font-family: Theme.font-mono; font-size: Theme.fs-meta; vertical-alignment: center; }
                        }
                    }
                }
                Hairline { }

                for mp in [
                    { id: "copy_pose", lbl: "Copiar pose completa (8h)", sc: "Ctrl+Shift+C" },
                    { id: "paste_pose", lbl: "Pegar pose completa aquí", sc: "Ctrl+Shift+V" },
                    { id: "del_pose", lbl: "Borrar frame completo (8h)", sc: "Shift+Supr" },
                ] : TouchArea {
                    height: 26px; mouse-cursor: pointer;
                    clicked => {
                        root.close-popovers();
                        if (mp.id == "copy_pose") { root.copy-pose-action(); }
                        else if (mp.id == "paste_pose") { root.paste-pose-action(); }
                        else if (mp.id == "del_pose") { root.delete-full-keyframe-action(); }
                    }
                    Rectangle {
                        border-radius: Theme.radius-control;
                        background: parent.has-hover ? Theme.bg-hover : transparent;
                        HorizontalLayout {
                            padding-left: 10px; padding-right: 10px; alignment: space-between;
                            Text { text: mp.lbl; color: Theme.text-secondary; font-size: Theme.fs-body; vertical-alignment: center; }
                            Text { text: mp.sc; color: Theme.text-dim; font-family: Theme.font-mono; font-size: Theme.fs-meta; vertical-alignment: center; }
                        }
                    }
                }
            }
        }

        // 1. POPOVER: ARCHIVO ▾ (DEC-04, DEC-06, DEC-07)
        if root.file-menu-open : Rectangle {
            x: 8px;
            y: 38px;
            width: 244px;
            height: 296px;
            border-radius: Theme.radius-overlay;
            background: Theme.bg-popover;
            border-width: 1px;
            border-color: Theme.border-control;

            TouchArea { width: 100%; height: 100%; }
            VerticalLayout {
                padding: 6px;
                spacing: 2px;

                for item in [
                    { id: "new", lbl: "Nueva escena en blanco", sc: "" },
                    { id: "import", lbl: "Importar ítems (.png/.json)…", sc: "" },
                    { id: "demos", lbl: "Cargar presets demo", sc: "" },
                    { id: "search", lbl: "Búsqueda rápida…", sc: "Ctrl+K" },
                ] : TouchArea {
                    height: 28px; mouse-cursor: pointer;
                    clicked => {
                        root.close-popovers();
                        if (item.id == "new") { root.reset-blank-scene(); }
                        else if (item.id == "import") { root.import-custom-weapons(); }
                        else if (item.id == "demos") { root.load-demo-presets(); }
                        else { root.open-palette(); }
                    }
                    Rectangle {
                        border-radius: Theme.radius-control;
                        background: parent.has-hover ? Theme.bg-hover : transparent;
                        HorizontalLayout {
                            padding-left: 10px; padding-right: 10px; alignment: space-between;
                            Text { text: item.lbl; color: Theme.text-primary; font-size: Theme.fs-body; vertical-alignment: center; }
                            Text { text: item.sc; color: Theme.text-dim; font-family: Theme.font-mono; font-size: Theme.fs-meta; vertical-alignment: center; }
                        }
                    }
                }

                Hairline { }

                for hist in [
                    { id: "undo", lbl: "Deshacer", sc: "Ctrl+Z", en: root.can-undo },
                    { id: "redo", lbl: "Rehacer", sc: "Ctrl+Y", en: root.can-redo },
                ] : TouchArea {
                    height: 28px; mouse-cursor: hist.en ? pointer : default;
                    clicked => {
                        if (hist.en) {
                            root.close-popovers();
                            if (hist.id == "undo") { root.undo-action(); } else { root.redo-action(); }
                        }
                    }
                    Rectangle {
                        border-radius: Theme.radius-control;
                        background: (hist.en && parent.has-hover) ? Theme.bg-hover : transparent;
                        HorizontalLayout {
                            padding-left: 10px; padding-right: 10px; alignment: space-between;
                            Text { text: hist.lbl; color: hist.en ? Theme.text-primary : Theme.text-dim; font-size: Theme.fs-body; vertical-alignment: center; }
                            Text { text: hist.sc; color: Theme.text-dim; font-family: Theme.font-mono; font-size: Theme.fs-meta; vertical-alignment: center; }
                        }
                    }
                }

                Hairline { }

                for exp in [
                    { id: "export", lbl: "Exportar proyecto…", sc: "Ctrl+E" },
                    { id: "strip", lbl: "Exportar tira PNG (6 frames)", sc: "" },
                    { id: "settings", lbl: "Ajustes de estilo y motor…", sc: "Ctrl+," },
                ] : TouchArea {
                    height: 28px; mouse-cursor: pointer;
                    clicked => {
                        root.close-popovers();
                        if (exp.id == "export") { root.export-modal-open = true; }
                        else if (exp.id == "strip") { root.export-strip-png-action(); }
                        else { root.settings-modal-open = true; }
                    }
                    Rectangle {
                        border-radius: Theme.radius-control;
                        background: parent.has-hover ? Theme.bg-hover : transparent;
                        HorizontalLayout {
                            padding-left: 10px; padding-right: 10px; alignment: space-between;
                            Text { text: exp.lbl; color: Theme.text-primary; font-size: Theme.fs-body; vertical-alignment: center; }
                            Text { text: exp.sc; color: Theme.text-dim; font-family: Theme.font-mono; font-size: Theme.fs-meta; vertical-alignment: center; }
                        }
                    }
                }
            }
        }

        // 2. POPOVER: CLIP SWITCHER ▾ (Attack 1 • ▾: switch, create, clone, inline rename)
        if root.clip-switcher-open : Rectangle {
            x: (parent.width - 280px) / 2;
            y: 38px;
            width: 280px;
            height: min(360px, 76px + root.gallery-items.length * 30px);
            border-radius: Theme.radius-overlay;
            background: Theme.bg-popover;
            border-width: 1px;
            border-color: Theme.border-control;

            TouchArea { width: 100%; height: 100%; }
            VerticalLayout {
                padding: 8px;
                spacing: 6px;
                HorizontalLayout {
                    spacing: 4px;
                    StudioButton { horizontal-stretch: 1; compact: true; label: "+ Nuevo clip"; clicked => { root.close-popovers(); root.create-blank-clip(); } }
                    StudioButton { horizontal-stretch: 1; compact: true; label: "Duplicar"; clicked => { root.close-popovers(); root.add-gallery-clip(root.featured-gallery-id); } }
                    StudioButton { width: 76px; compact: true; label: "Renombrar"; clicked => {
                        root.close-popovers();
                        root.clip-rename-draft = root.active-clip-name;
                        root.clip-renaming = true;
                    } }
                }
                Hairline { }
                ListView {
                    vertical-stretch: 1;
                    for item in root.gallery-items : TouchArea {
                        height: 28px; mouse-cursor: pointer;
                        clicked => { root.close-popovers(); root.select-gallery-item(item.id); }
                        Rectangle {
                            border-radius: Theme.radius-control;
                            background: item.active ? Theme.bg-active : (parent.has-hover ? Theme.bg-hover : transparent);
                            HorizontalLayout {
                                padding-left: 8px; padding-right: 8px; spacing: 8px; alignment: space-between;
                                Text { text: item.name; color: Theme.text-primary; font-size: Theme.fs-body; font-weight: item.active ? 600 : 400; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                                Text { text: item.source_label; color: Theme.text-dim; font-family: Theme.font-mono; font-size: Theme.fs-meta; vertical-alignment: center; }
                            }
                        }
                    }
                }
            }
        }

        // 3. POPOVER: WEAPON PICKER [⚔ Katana ▾] (with monochrome Fijar button: DEC-13)
        if root.weapon-picker-open : Rectangle {
            x: 8px;
            y: 74px;
            width: 310px;
            height: 460px;
            border-radius: Theme.radius-overlay;
            background: Theme.bg-popover;
            border-width: 1px;
            border-color: Theme.border-control;

            TouchArea { width: 100%; height: 100%; }
            VerticalLayout {
                padding: 10px;
                spacing: 8px;

                HorizontalLayout {
                    alignment: space-between;
                    Text { text: "Catálogo de Ítems (" + root.total-weapon-count + ")"; color: Theme.text-primary; font-size: Theme.fs-body; font-weight: 600; vertical-alignment: center; }
                    HorizontalLayout {
                        spacing: 4px;
                        StudioButton { width: 68px; compact: true; ghost: true; label: "+ Importar"; clicked => { root.close-popovers(); root.import-custom-weapons(); } }
                        StudioButton {
                            width: 56px; compact: true;
                            active: root.weapons-pinned;
                            label: "Fijar";
                            clicked => {
                                root.weapons-pinned = true;
                                root.close-popovers();
                            }
                        }
                    }
                }

                Rectangle {
                    height: 28px; border-radius: Theme.radius-control;
                    background: Theme.wireframe-controls ? transparent : Theme.bg-input;
                    border-width: 1px; border-color: pop-w-search.has-focus ? Theme.accent : Theme.border-control;
                    HorizontalLayout {
                        padding-left: 8px; padding-right: 8px; spacing: 6px;
                        VectorIcon { y: 7px; size: 13px; icon-color: Theme.text-dim; commands: "M11 4 A7 7 0 1 0 11 18 A7 7 0 1 0 11 4 Z M20 20 L16 16"; }
                        Rectangle {
                            horizontal-stretch: 1; height: 28px; clip: true;
                            if root.weapon-search == "" : Text { width: parent.width; height: parent.height; text: "Buscar arma o ítem..."; color: Theme.text-dim; font-size: Theme.fs-body; vertical-alignment: center; }
                            pop-w-search := TextInput {
                                width: parent.width; height: parent.height;
                                text <=> root.weapon-search; color: Theme.text-primary; font-size: Theme.fs-body;
                                single-line: true; vertical-alignment: center;
                                init => { self.focus(); }
                                changed has-focus => { root.text-input-active = self.has-focus; }
                                edited => { root.search-weapons(self.text); }
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 4px;
                    StudioButton {
                        horizontal-stretch: 1; compact: true;
                        label: "Familia: " + (root.selected-category < root.categories.length ? root.categories[root.selected-category].name : "Todas");
                        clicked => { root.select-category(root.selected-category + 1 >= root.categories.length ? 0 : root.selected-category + 1); }
                    }
                    StudioButton {
                        width: 88px; compact: true; active: root.weapon-status-filter > 0;
                        label: root.weapon-status-filter == 0 ? "Todos"
                             : (root.weapon-status-filter == 1 ? "Pendiente"
                             : (root.weapon-status-filter == 2 ? "Aprobada"
                             : (root.weapon-status-filter == 3 ? "Mejorar" : "Descartada")));
                        clicked => { root.filter-weapon-status(root.weapon-status-filter >= 4 ? 0 : root.weapon-status-filter + 1); }
                    }
                }

                ListView {
                    vertical-stretch: 1;
                    for w in root.filtered-weapons : TouchArea {
                        height: 30px; mouse-cursor: pointer;
                        clicked => { root.select-weapon(w.index); }
                        Rectangle {
                            border-radius: Theme.radius-control;
                            background: root.active-weapon-index == w.index ? Theme.bg-active : (parent.has-hover ? Theme.bg-hover : transparent);
                            HorizontalLayout {
                                padding-left: 8px; padding-right: 8px; spacing: 8px;
                                Image { width: 18px; height: 18px; y: 6px; source: w.icon; image-rendering: pixelated; }
                                Text { text: w.name; color: Theme.text-primary; font-size: Theme.fs-body; font-weight: root.active-weapon-index == w.index ? 600 : 400; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                                Text { text: w.category; color: Theme.text-dim; font-size: Theme.fs-meta; vertical-alignment: center; }
                            }
                        }
                    }
                }

                Hairline { }

                HorizontalLayout {
                    spacing: 8px; height: 48px;
                    Image { width: 48px; height: 48px; source: root.weapon-card-img; image-fit: contain; }
                    VerticalLayout {
                        horizontal-stretch: 1; spacing: 4px; alignment: center;
                        Text { text: root.active-weapon-mod + " · " + root.active-weapon-family; color: Theme.text-secondary; font-size: Theme.fs-meta; overflow: elide; }
                        HorizontalLayout {
                            spacing: 4px;
                            StudioButton { horizontal-stretch: 1; compact: true; ghost: true; label: "Aprobar"; active: root.active-weapon-status == 1; clicked => { root.set-weapon-status(root.active-weapon-index, 1); } }
                            StudioButton { horizontal-stretch: 1; compact: true; ghost: true; label: "Mejorar"; active: root.active-weapon-status == 2; clicked => { root.set-weapon-status(root.active-weapon-index, 2); } }
                            StudioButton { width: 66px; compact: true; ghost: true; label: "Descartar"; active: root.active-weapon-status == 3; clicked => { root.set-weapon-status(root.active-weapon-index, 3); } }
                        }
                    }
                }
            }
        }

        // 4. POPOVER: CÁMARA ▾ (DEC-15)
        if root.camera-menu-open : Rectangle {
            x: (root.focus-mode ? parent.width : parent.width - 272px) - 220px;
            y: 84px;
            width: 196px;
            height: 204px;
            border-radius: Theme.radius-overlay;
            background: Theme.bg-popover;
            border-width: 1px;
            border-color: Theme.border-control;

            TouchArea { width: 100%; height: 100%; }
            VerticalLayout {
                padding: 6px;
                spacing: 2px;
                for cam in [
                    { idx: 0, lbl: "Vista 3/4", sc: "" },
                    { id: "front", idx: 1, lbl: "Frente", sc: "" },
                    { id: "side", idx: 2, lbl: "Lado", sc: "" },
                    { id: "back", idx: 3, lbl: "Espalda", sc: "" },
                ] : TouchArea {
                    height: 28px; mouse-cursor: pointer;
                    clicked => { root.close-popovers(); root.set-camera-preset(cam.idx); }
                    Rectangle {
                        border-radius: Theme.radius-control;
                        background: parent.has-hover ? Theme.bg-hover : transparent;
                        HorizontalLayout {
                            padding-left: 10px; padding-right: 10px;
                            Text { text: cam.lbl; color: Theme.text-primary; font-size: Theme.fs-body; vertical-alignment: center; }
                        }
                    }
                }
                Hairline { }
                TouchArea {
                    height: 28px; mouse-cursor: pointer;
                    clicked => { root.close-popovers(); root.focus-bone(); }
                    Rectangle {
                        border-radius: Theme.radius-control;
                        background: parent.has-hover ? Theme.bg-hover : transparent;
                        HorizontalLayout {
                            padding-left: 10px; padding-right: 10px; alignment: space-between;
                            Text { text: "Enfocar hueso"; color: Theme.text-primary; font-size: Theme.fs-body; vertical-alignment: center; }
                            Text { text: "F"; color: Theme.text-dim; font-family: Theme.font-mono; font-size: Theme.fs-meta; vertical-alignment: center; }
                        }
                    }
                }
                TouchArea {
                    height: 28px; mouse-cursor: pointer;
                    clicked => { root.close-popovers(); root.reset-camera(); }
                    Rectangle {
                        border-radius: Theme.radius-control;
                        background: parent.has-hover ? Theme.bg-hover : transparent;
                        HorizontalLayout {
                            padding-left: 10px; padding-right: 10px; alignment: space-between;
                            Text { text: "Centrar cámara"; color: Theme.text-primary; font-size: Theme.fs-body; vertical-alignment: center; }
                            Text { text: "R"; color: Theme.text-dim; font-family: Theme.font-mono; font-size: Theme.fs-meta; vertical-alignment: center; }
                        }
                    }
                }
            }
        }

        // 5. POPOVER: VISTA ▾ (DEC-15: Solo Arma, Cebolla, Estela, Sombras, Entorno)
        if root.view-menu-open : Rectangle {
            x: (root.focus-mode ? parent.width : parent.width - 272px) - 246px;
            y: 84px;
            width: 234px;
            height: 224px;
            border-radius: Theme.radius-overlay;
            background: Theme.bg-popover;
            border-width: 1px;
            border-color: Theme.border-control;

            TouchArea { width: 100%; height: 100%; }
            VerticalLayout {
                padding: 12px;
                spacing: 10px;

                HorizontalLayout {
                    alignment: space-between;
                    Text { text: "Solo arma (ocultar rig)"; color: Theme.text-primary; font-size: Theme.fs-body; vertical-alignment: center; }
                    StudioSwitch { checked: root.solo-weapon; toggled => { root.toggle-solo-weapon(); } }
                }
                HorizontalLayout {
                    alignment: space-between;
                    Text { text: "Papel cebolla (ghost)"; color: Theme.text-primary; font-size: Theme.fs-body; vertical-alignment: center; }
                    StudioSwitch { checked: root.onion-enabled; toggled(v) => { root.toggle-onion(v); } }
                }
                HorizontalLayout {
                    alignment: space-between;
                    Text { text: "Estela de golpe (trail)"; color: Theme.text-primary; font-size: Theme.fs-body; vertical-alignment: center; }
                    StudioSwitch { checked: root.trail-enabled; toggled(v) => { root.toggle-trail(v); } }
                }
                HorizontalLayout {
                    alignment: space-between;
                    Text { text: "Sombras en suelo"; color: Theme.text-primary; font-size: Theme.fs-body; vertical-alignment: center; }
                    StudioSwitch { checked: root.shadows-enabled; toggled(v) => { root.toggle-shadows(v); } }
                }
                Hairline { }
                VerticalLayout {
                    spacing: 5px;
                    Text { text: "Entorno 3D"; color: Theme.text-dim; font-size: Theme.fs-meta; }
                    HorizontalLayout {
                        spacing: 4px;
                        for bg[bi] in ["Estudio", "Sakura", "Océano"] : StudioButton {
                            compact: true; horizontal-stretch: 1; label: bg;
                            active: root.bg-idx == bi; clicked => { root.set-bg-mode(bi); }
                        }
                    }
                }
            }
        }

        // ==================== MODAL: EXPORTAR (Archivo ▾ -> Exportar / Ctrl+E) ====================
        if root.export-modal-open : TouchArea {
            width: 100%; height: 100%;
            clicked => { root.export-modal-open = false; root-focus.focus(); }
            Rectangle { width: 100%; height: 100%; background: #00000078; }
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 540px;
                height: 360px;
                border-radius: Theme.radius-overlay;
                background: Theme.bg-sidebar;
                border-width: 1px;
                border-color: Theme.border-control;

                TouchArea { width: 100%; height: 100%; }
                VerticalLayout {
                    padding: 20px;
                    spacing: 14px;

                    HorizontalLayout {
                        alignment: space-between;
                        VerticalLayout {
                            spacing: 2px;
                            Text { text: "Exportar Proyecto y Animaciones"; color: Theme.text-primary; font-size: Theme.fs-title; font-weight: 700; }
                            Text {
                                text: root.has-rell-profile ? root.rell-profile-label : (root.clips-count + " clips · " + root.total-weapon-count + " ítems · " + root.rell-profile-label);
                                color: Theme.text-dim;
                                font-size: Theme.fs-meta;
                            }
                        }
                        IconActionBtn { path-cmd: "M18 6 L6 18 M6 6 L18 18"; clicked => { root.export-modal-open = false; } }
                    }

                    Hairline { }

                    HorizontalLayout {
                        alignment: space-between;
                        Text { text: "Formato de destino"; color: Theme.text-secondary; font-size: Theme.fs-body; vertical-alignment: center; }
                        HorizontalLayout {
                            width: 300px; spacing: 4px;
                            StudioButton { compact: true; horizontal-stretch: 1; label: "Bedrock 1.8"; active: root.export-format-idx == 0; clicked => { root.export-format-idx = 0; } }
                            StudioButton { compact: true; horizontal-stretch: 1; label: "GeckoLib 4"; active: root.export-format-idx == 1; clicked => { root.export-format-idx = 1; } }
                            StudioButton { compact: true; horizontal-stretch: 1; label: "Ambos"; active: root.export-format-idx == 2; clicked => { root.export-format-idx = 2; } }
                        }
                    }

                    HorizontalLayout {
                        spacing: 8px;
                        Text { width: 112px; text: "Carpeta de salida"; color: Theme.text-secondary; font-size: Theme.fs-body; vertical-alignment: center; }
                        Rectangle {
                            horizontal-stretch: 1; height: 28px; border-radius: Theme.radius-control;
                            background: Theme.bg-input; border-width: 1px; border-color: Theme.border-control; clip: true;
                            Text { x: 8px; width: parent.width - 16px; text: root.export-dest; color: Theme.text-primary; font-family: Theme.font-mono; font-size: Theme.fs-mono; overflow: elide; vertical-alignment: center; }
                        }
                        StudioButton { width: 84px; label: "Elegir…"; clicked => { root.browse-export-dest(); } }
                    }

                    HorizontalLayout {
                        alignment: space-between;
                        Text { text: "Incluir eventos de sonido y partículas"; color: Theme.text-secondary; font-size: Theme.fs-body; vertical-alignment: center; }
                        StudioSwitch { checked: root.include-events; toggled(v) => { root.include-events = v; } }
                    }
                    HorizontalLayout {
                        alignment: space-between;
                        Text { text: "Optimizar keyframes redundantes"; color: Theme.text-secondary; font-size: Theme.fs-body; vertical-alignment: center; }
                        StudioSwitch { checked: root.optimize-keyframes; toggled(v) => { root.optimize-keyframes = v; } }
                    }

                    Hairline { }

                    HorizontalLayout {
                        alignment: space-between;
                        spacing: 10px;
                        StudioButton { width: 208px; label: "Exportar Tira PNG (6 frames)"; clicked => { root.export-strip-png-action(); } }
                        if root.has-rell-profile : StudioButton {
                            horizontal-stretch: 1; primary: true;
                            label: "Exportar RELL Seas (F3+T)";
                            clicked => { root.export-rell-seas-action(); root.export-modal-open = false; }
                        }
                        if !root.has-rell-profile : StudioButton {
                            horizontal-stretch: 1; primary: true;
                            label: "Exportar Proyecto Completo";
                            clicked => { root.export-project-action(); root.export-modal-open = false; }
                        }
                    }
                }
            }
        }

        // ==================== MODAL: AJUSTES [⚙] (5 Hero DesignSpec Directions) ====================
        if root.settings-modal-open : TouchArea {
            width: 100%; height: 100%;
            clicked => { root.settings-modal-open = false; root-focus.focus(); }
            Rectangle { width: 100%; height: 100%; background: #00000078; }
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 780px;
                height: 418px;
                border-radius: Theme.radius-overlay;
                background: Theme.bg-sidebar;
                border-width: 1px;
                border-color: Theme.border-control;

                TouchArea { width: 100%; height: 100%; }
                VerticalLayout {
                    padding: 20px;
                    spacing: 14px;
                    alignment: start;

                    HorizontalLayout {
                        alignment: space-between;
                        Text { text: "Ajustes de Dirección Artística y Motor"; color: Theme.text-primary; font-size: Theme.fs-title; font-weight: 700; vertical-alignment: center; }
                        IconActionBtn { path-cmd: "M18 6 L6 18 M6 6 L18 18"; clicked => { root.settings-modal-open = false; } }
                    }

                    Hairline { }

                    // 5 Real Distinct Hero Directions (Geometry, Material, Polarity, Mono, 3D Stage)
                    VerticalLayout {
                        spacing: 8px;
                        SectionLabel { text: "DIRECCIÓN ARTÍSTICA (GEOMETRÍA, MATERIAL, TIPOGRAFÍA Y ESCENARIO 3D)"; }
                        HorizontalLayout {
                            spacing: 8px;
                            for th in [
                                { idx: 0, title: "Pro Studio Neutral", sub: "Grafito · Silent Chrome · 6px", bg: #18191d, dot: #0a84ff, r: 6px, txt: #f2f3f7 },
                                { idx: 1, title: "Field Hardware", sub: "Mate 2px · Switch · Mono", bg: #1b1c20, dot: #ff5500, r: 2px, txt: #f2f3f5 },
                                { idx: 2, title: "Daylight Studio", sub: "Porcelana clara · 3D neutro", bg: #f4f5f8, dot: #0066cc, r: 7px, txt: #14171f },
                                { idx: 3, title: "CAD Blueprint", sub: "Ortogonal 0px · Cobalto", bg: #0b1729, dot: #38bdf8, r: 0px, txt: #e6f2ff },
                                { idx: 4, title: "Studio Clay", sub: "Piedra cálida · Terracota", bg: #1d1a17, dot: #e07a38, r: 8px, txt: #f5f1ec },
                            ] : TouchArea {
                                horizontal-stretch: 1;
                                height: 96px;
                                mouse-cursor: pointer;
                                clicked => { root.select-theme(th.idx); }
                                Rectangle {
                                    border-radius: th.r;
                                    background: th.bg;
                                    border-width: root.theme-idx == th.idx ? 2px : 1px;
                                    border-color: root.theme-idx == th.idx ? Theme.accent : Theme.border-control;
                                    VerticalLayout {
                                        padding: 10px;
                                        spacing: 6px;
                                        HorizontalLayout {
                                            alignment: space-between;
                                            Rectangle { width: 12px; height: 12px; border-radius: th.r; background: th.dot; }
                                            if root.theme-idx == th.idx : Text { text: "Activo"; color: th.dot; font-family: Theme.font-mono; font-size: Theme.fs-meta; font-weight: 700; }
                                        }
                                        Text { text: th.title; color: th.txt; font-size: Theme.fs-body; font-weight: 700; wrap: word-wrap; }
                                        Text { text: th.sub; color: th.dot; font-size: Theme.fs-meta; wrap: word-wrap; }
                                    }
                                }
                            }
                        }
                    }

                    Hairline { }

                    HorizontalLayout {
                        alignment: space-between;
                        VerticalLayout {
                            spacing: 2px; horizontal-stretch: 1;
                            Text { text: "Animaciones de interfaz (Spring)"; color: Theme.text-primary; font-size: Theme.fs-body; font-weight: 600; }
                            Text { text: "Desactivar reduce transiciones a 0ms."; color: Theme.text-dim; font-size: Theme.fs-meta; }
                        }
                        StudioSwitch { checked: root.ui-motion-enabled; toggled(on) => { root.toggle-ui-motion(on); } }
                    }

                    HorizontalLayout {
                        alignment: space-between;
                        VerticalLayout {
                            spacing: 2px; horizontal-stretch: 1;
                            Text { text: "Perfil de GPU (aplica al reiniciar)"; color: Theme.text-primary; font-size: Theme.fs-body; font-weight: 600; }
                            Text { text: root.gpu-adapter-name + " · 0% CPU en reposo"; color: Theme.green; font-size: Theme.fs-meta; }
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            StudioButton { width: 140px; label: "Alto Rendimiento"; active: !root.gpu-low-power; clicked => { root.set-gpu-power-mode(false); } }
                            StudioButton { width: 140px; label: "Ahorro Batería"; active: root.gpu-low-power; clicked => { root.set-gpu-power-mode(true); } }
                        }
                    }

                    Hairline { }

                    Text {
                        text: "Atajos: Ctrl+K (Buscar) · Ctrl+E (Exportar) · Ctrl+, (Ajustes) · Ctrl+Z/Y (Historial) · Espacio (Play) · Flechas (±1f) · Tab (Expandir 3D) · F (Enfocar) · R (Centrar)";
                        color: Theme.text-dim;
                        font-size: Theme.fs-meta;
                        wrap: word-wrap;
                    }
                }
            }
        }

        // ==================== MODAL: SPOTLIGHT PALETTE (Ctrl+K) ====================
        if root.palette-open : TouchArea {
            width: 100%; height: 100%;
            clicked => {
                root.text-input-active = false;
                root-focus.focus();
                root.close-palette();
            }
            Rectangle { width: 100%; height: 100%; background: #00000078; }
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: 80px;
                width: 520px;
                height: min(360px, 68px + root.palette-items.length * 40px);
                border-radius: Theme.radius-overlay;
                background: Theme.bg-popover;
                border-width: 1px;
                border-color: Theme.border-control;

                TouchArea { width: 100%; height: 100%; }
                VerticalLayout {
                    padding: 10px;
                    spacing: 8px;

                    Rectangle {
                        height: 34px; border-radius: Theme.radius-control;
                        background: Theme.bg-input; border-width: 1px; border-color: Theme.accent;
                        HorizontalLayout {
                            padding-left: 10px; padding-right: 10px; spacing: 8px;
                            VectorIcon { size: 14px; y: 10px; icon-color: Theme.accent; commands: "M11 4 A7 7 0 1 0 11 18 A7 7 0 1 0 11 4 Z M20 20 L16 16"; }
                            Rectangle {
                                horizontal-stretch: 1; height: 34px; clip: true;
                                if root.palette-query == "" : Text { width: parent.width; height: parent.height; text: "Buscar clip, ítem o comando… (Esc)"; color: Theme.text-dim; font-size: Theme.fs-body; vertical-alignment: center; }
                                palette-search-edit := TextInput {
                                    width: parent.width; height: parent.height;
                                    text <=> root.palette-query; color: Theme.text-primary; font-size: Theme.fs-body;
                                    single-line: true; vertical-alignment: center;
                                    init => { self.focus(); }
                                    changed has-focus => { root.text-input-active = self.has-focus; }
                                    edited => { root.search-palette(self.text); }
                                    accepted => {
                                        root.text-input-active = false;
                                        root-focus.focus();
                                        root.exec-first-palette-item();
                                    }
                                }
                            }
                        }
                    }

                    ListView {
                        vertical-stretch: 1;
                        for pe in root.palette-items : TouchArea {
                            height: 38px; mouse-cursor: pointer;
                            clicked => {
                                root.text-input-active = false;
                                root-focus.focus();
                                root.exec-palette-item(pe.id);
                            }
                            Rectangle {
                                border-radius: Theme.radius-control;
                                background: parent.has-hover ? Theme.bg-hover : transparent;
                                HorizontalLayout {
                                    padding-left: 10px; padding-right: 10px; spacing: 10px; alignment: space-between;
                                    VerticalLayout {
                                        spacing: 1px; horizontal-stretch: 1; alignment: center;
                                        Text { text: pe.title; color: Theme.text-primary; font-size: Theme.fs-body; font-weight: 600; overflow: elide; }
                                        Text { text: pe.subtitle; color: Theme.text-dim; font-size: Theme.fs-meta; overflow: elide; }
                                    }
                                    Text { text: pe.kind; color: Theme.text-dim; font-family: Theme.font-mono; font-size: Theme.fs-meta; vertical-alignment: center; }
                                }
                            }
                        }
                    }
                }
            }
        }
    } // end root-focus

    // Subtle Non-Intrusive Toast Banner (bottom-right above Timeline edge)
    Rectangle {
        x: parent.width - self.width - 16px;
        y: root.toast-visible ? parent.height - 198px : parent.height - 188px;
        opacity: root.toast-visible ? 1.0 : 0.0;
        visible: self.opacity > 0.01;
        width: min(380px, parent.width - 40px);
        height: 30px;
        border-radius: Theme.radius-overlay;
        background: Theme.bg-toast;
        border-width: 1px;
        border-color: Theme.border-control;
        animate opacity { duration: Theme.dur-effects; easing: cubic-bezier(0, 0, 0, 1); }
        animate y { duration: Theme.dur-spatial; easing: spring(0.14); }
        Text {
            text: root.toast-message;
            color: #ffffff;
            font-size: Theme.fs-body;
            font-weight: 500;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
